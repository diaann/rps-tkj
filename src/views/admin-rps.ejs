<%- include('partials/header') %>

    <div class="container-custom">
        <!-- Admin RPS Management Header -->
        <div class="card mb-6">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
                <div>
                    <h1 class="text-2xl font-bold text-gray-800 mb-2">Kelola RPS - Admin</h1>
                    <p class="text-gray-600">Kelola seluruh RPS yang dibuat oleh dosen</p>
                    <p class="text-sm text-gray-500 mt-1">Total RPS: <span class="font-semibold">
                            <%= rps.length %>
                        </span></p>
                </div>
                <div class="mt-4 md:mt-0 flex gap-2">
                    <a href="/admin" class="btn-secondary flex items-center gap-2 px-4 py-2 text-sm">
                        <i class="fas fa-users"></i>
                        Kelola User
                    </a>
                    <a href="/create-rps" class="btn-primary flex items-center gap-2 px-4 py-2 text-sm">
                        <i class="fas fa-plus"></i>
                        Buat RPS Baru
                    </a>
                </div>
            </div>
        </div>

        <!-- Statistics Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-5 gap-4 mb-6">
            <div class="card dashboard-stat-card">
                <div class="flex items-center justify-center">
                    <div class="p-3 rounded-full bg-blue-100 text-blue-600 mr-4">
                        <i class="fas fa-file-alt text-xl"></i>
                    </div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-gray-800">
                            <%= rps.length %>
                        </p>
                        <p class="text-gray-600 text-sm font-medium">Total RPS</p>
                    </div>
                </div>
            </div>

            <div class="card dashboard-stat-card">
                <div class="flex items-center justify-center">
                    <div class="p-3 rounded-full bg-yellow-100 text-yellow-600 mr-4">
                        <i class="fas fa-hourglass-half text-xl"></i>
                    </div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-gray-800">
                            <%= rps.filter(r=> (r.status || 'draft') === 'diajukan').length %>
                        </p>
                        <p class="text-gray-600 text-sm font-medium">Menunggu Persetujuan</p>
                    </div>
                </div>
            </div>

            <div class="card dashboard-stat-card">
                <div class="flex items-center justify-center">
                    <div class="p-3 rounded-full bg-green-100 text-green-600 mr-4">
                        <i class="fas fa-users text-xl"></i>
                    </div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-gray-800">
                            <%= users.filter(u=> u.role === 'dosen').length %>
                        </p>
                        <p class="text-gray-600 text-sm font-medium">Total Dosen</p>
                    </div>
                </div>
            </div>

            <div class="card dashboard-stat-card">
                <div class="flex items-center justify-center">
                    <div class="p-3 rounded-full bg-yellow-100 text-yellow-600 mr-4">
                        <i class="fas fa-calendar text-xl"></i>
                    </div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-gray-800">
                            <%= [...new Set(rps.map(r=> r.tahun_akademik))].length %>
                        </p>
                        <p class="text-gray-600 text-sm font-medium">Tahun Akademik</p>
                    </div>
                </div>
            </div>

            <div class="card dashboard-stat-card">
                <div class="flex items-center justify-center">
                    <div class="p-3 rounded-full bg-purple-100 text-purple-600 mr-4">
                        <i class="fas fa-graduation-cap text-xl"></i>
                    </div>
                    <div class="text-center">
                        <p class="text-2xl font-bold text-gray-800">
                            <%= [...new Set(rps.map(r=> r.semester))].length %>
                        </p>
                        <p class="text-gray-600 text-sm font-medium">Semester</p>
                    </div>
                </div>
            </div>
        </div>

        <!-- Filter and Search -->
        <div class="card mb-6">
            <div class="flex flex-col md:flex-row gap-4 md:items-center">
                <div class="flex-1">
                    <input type="text" id="searchRPS" placeholder="Cari nama mata kuliah, kode MK, atau nama dosen..."
                        class="input w-full">
                </div>
                <div class="filter-select-group">
                    <select id="filterSemester" class="input">
                        <option value="">Semua Semester</option>
                        <% [...new Set(rps.map(r=> r.semester))].sort().forEach(semester => { %>
                            <option value="<%= semester %>">Semester <%= semester %>
                            </option>
                            <% }); %>
                    </select>
                    <select id="filterTahun" class="input">
                        <option value="">Semua Tahun</option>
                        <% [...new Set(rps.map(r=> r.tahun_akademik))].sort().forEach(tahun => { %>
                            <option value="<%= tahun %>">
                                <%= tahun %>
                            </option>
                            <% }); %>
                    </select>
                    <select id="filterOwner" class="input">
                        <option value="">Semua Dosen</option>
                        <% [...new Set(rps.map(r=> r.ownerName))].sort().forEach(owner => { %>
                            <option value="<%= owner %>">
                                <%= owner %>
                            </option>
                            <% }); %>
                    </select>
                    <select id="filterStatus" class="input">
                        <option value="">Semua Status</option>
                        <option value="draft">Draft</option>
                        <option value="diajukan">Menunggu Persetujuan</option>
                        <option value="disetujui">Disetujui</option>
                        <option value="ditolak">Ditolak</option>
                    </select>
                </div>
            </div>
        </div>

        <!-- RPS List -->
        <div class="card">
            <!-- <div class="flex items-center justify-between mb-6">
                <div>
                    <h2 class="text-xl font-bold text-gray-800">Daftar RPS</h2>
                    <p class="text-gray-600 text-sm">Kelola semua RPS yang ada dalam sistem</p>
                </div>
            </div> -->
            <!-- BARU -->
            <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-6">
                <div>
                    <h2 class="text-xl font-bold text-gray-800">Daftar RPS</h2>
                    <p class="text-gray-600 text-sm">Kelola semua RPS yang ada dalam sistem</p>
                </div>

                <div class="flex items-center gap-2">
                    <label for="sortRPS" class="text-sm font-medium text-gray-700">
                        Urutkan:
                    </label>

                    <select id="sortRPS" class="input min-w-[190px]">
                        <option value="terbaru">Terbaru</option>
                        <option value="terlama">Terlama</option>
                        <option value="nama_az">Nama Matakuliah A-Z</option>
                        <option value="nama_za">Nama Matakuliah Z-A</option>
                    </select>
                </div>
            </div>

            <% if (rps.length> 0) { %>
                <%
                    const adminStatusBadgeClass = { draft: 'bg-gray-100 text-gray-700', diajukan: 'bg-yellow-100 text-yellow-800', disetujui: 'bg-green-100 text-green-800', ditolak: 'bg-red-100 text-red-800' };
                    const adminStatusBadgeLabel = { draft: 'Draft', diajukan: 'Menunggu Persetujuan', disetujui: 'Disetujui', ditolak: 'Ditolak' };
                %>
                <div id="rpsContainer" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                    <% rps.forEach(r=> { %>
                        <% const rStatus = r.status || 'draft'; const rLocked = rStatus === 'diajukan' || rStatus === 'disetujui'; %>
                        <!-- LAMA -->
                        <!-- <div class="rps-card card border border-gray-200 hover:shadow-lg transition-shadow duration-200"
                            data-semester="<%= r.semester %>" data-tahun="<%= r.tahun_akademik %>"
                            data-owner="<%= r.ownerName %>"
                            data-search="<%= (r.nama_mk + ' ' + r.kode_mk + ' ' + r.ownerName).toLowerCase() %>"> -->
                        <!-- BARU -->
                            <div class="rps-card card border border-gray-200 hover:shadow-lg transition-shadow duration-200"
                            data-semester="<%= r.semester %>"
                            data-tahun="<%= r.tahun_akademik %>"
                            data-owner="<%= r.ownerName %>"
                            data-status="<%= rStatus %>"
                            data-nama="<%= (r.nama_mk || '').toLowerCase() %>"
                            data-tanggal="<%= r.tanggal_penyusunan || '' %>"
                            data-search="<%= (r.nama_mk + ' ' + r.kode_mk + ' ' + r.ownerName).toLowerCase() %>">

                            <div class="flex items-start justify-between mb-3">
                                <div class="flex-1">
                                    <h3 class="text-lg font-bold text-gray-800 mb-1 line-clamp-2">
                                        <%= r.nama_mk %>
                                    </h3>
                                    <p class="text-blue-600 font-semibold text-sm">
                                        <%= r.kode_mk %>
                                    </p>
                                </div>
                                <div class="flex flex-col items-end gap-1">
                                    <span class="bg-blue-100 text-blue-800 text-xs font-medium px-2 py-1 rounded-full">
                                        Semester <%= r.semester %>
                                    </span>
                                    <span class="<%= adminStatusBadgeClass[rStatus] %> text-xs font-medium px-2 py-1 rounded-full">
                                        <%= adminStatusBadgeLabel[rStatus] %>
                                    </span>
                                </div>
                            </div>

                            <% if (rStatus === 'ditolak' && r.rejection_note) { %>
                                <p class="text-xs text-red-600 bg-red-50 rounded p-2 mb-3">
                                    <i class="fas fa-circle-exclamation mr-1"></i>Ditolak: <%= r.rejection_note %>
                                </p>
                            <% } %>

                            <div class="text-xs text-gray-500 mb-4 space-y-1">
                                <p><i class="fas fa-user mr-1"></i> <strong>Pembuat:</strong>
                                    <%= r.ownerName %>
                                </p>
                                <p><i class="fas fa-envelope mr-1"></i>
                                    <%= r.ownerEmail %>
                                </p>
                                <p><i class="fas fa-calendar mr-1"></i> Dibuat: <%= new
                                        Date(r.tanggal_penyusunan).toLocaleDateString('id-ID') %>
                                </p>
                                <p><i class="fas fa-graduation-cap mr-1"></i>
                                    <%= r.tahun_akademik %>
                                </p>
                                <p><i class="fas fa-users mr-1"></i>
                                    <%= Array.isArray(r.dosen_pengampu) ? r.dosen_pengampu.length :
                                        (r['dosen_pengampu[]'] ? r['dosen_pengampu[]'].length : 1) %>
                                        Dosen Pengampu
                                </p>
                            </div>

                            <div class="rps-card-actions">
                                <a href="/history/view/<%= r.id %>" class="rps-btn rps-btn-view">
                                    <i class="fas fa-eye"></i>Lihat
                                </a>
                                <div class="rps-action-row">
                                    <a href="/export/word-1/<%= r.id %>" class="rps-btn rps-btn-word1">
                                        <i class="fas fa-download"></i>Word-1
                                    </a>
                                    <a href="/export/word-2/<%= r.id %>" class="rps-btn rps-btn-word2">
                                        <i class="fas fa-download"></i>Word-2
                                    </a>
                                </div>
                                <div class="rps-action-row">
                                    <% if (!rLocked) { %>
                                        <a href="/edit-rps/<%= r.id %>" class="rps-btn rps-btn-manage">
                                            <i class="fas fa-edit"></i>Edit
                                        </a>
                                        <% } %>
                                            <a href="/history/rps/<%= r.id %>" class="rps-btn rps-btn-manage">
                                                <i class="fas fa-clock-rotate-left"></i>History
                                            </a>
                                </div>
                                <div class="flex gap-2">
                                            <button class="rps-btn rps-btn-manage" style="flex:1" data-id="<%= r.id %>"
                                                data-name="<%= r.nama_mk %>" data-owner="<%= r.ownerName %>"
                                                onclick="duplicateRpsAdmin(this)">
                                                <i class="fas fa-clone"></i>Duplikat
                                            </button>
                                            <button class="rps-btn rps-btn-delete" data-id="<%= r.id %>"
                                                data-name="<%= r.nama_mk %>" data-owner="<%= r.ownerName %>"
                                                onclick="deleteRpsAdmin(this)">
                                                <i class="fas fa-trash"></i>
                                            </button>
                                        </div>
                            </div>
                        </div>
                        <% }); %>
                </div>

                <!-- No results message (initially hidden) -->
                <div id="noResults" class="text-center py-12 hidden">
                    <div class="mx-auto w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mb-6">
                        <i class="fas fa-search text-4xl text-gray-400"></i>
                    </div>
                    <h3 class="text-lg font-semibold text-gray-800 mb-2">Tidak ada RPS yang ditemukan</h3>
                    <p class="text-gray-600 mb-6">Coba ubah kriteria pencarian atau filter Anda.</p>
                </div>
                <% } else { %>
                    <div class="text-center py-12">
                        <div class="mx-auto w-24 h-24 bg-gray-100 rounded-full flex items-center justify-center mb-6">
                            <svg class="w-12 h-12 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                                    d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                                </path>
                            </svg>
                        </div>
                        <h3 class="text-lg font-semibold text-gray-800 mb-2">Belum ada RPS dalam sistem</h3>
                        <p class="text-gray-600 mb-6">Belum ada dosen yang membuat RPS.</p>
                    </div>
                    <% } %>
        </div>
    </div>

    <%- include('partials/footer') %>
        <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

        <script>
            // Search and filter functionality
            // LAMA
            // document.addEventListener('DOMContentLoaded', function () {
            //     const searchInput = document.getElementById('searchRPS');
            //     const semesterFilter = document.getElementById('filterSemester');
            //     const tahunFilter = document.getElementById('filterTahun');
            //     const ownerFilter = document.getElementById('filterOwner');
            //     const rpsCards = document.querySelectorAll('.rps-card');
            //     const rpsContainer = document.getElementById('rpsContainer');
            //     const noResults = document.getElementById('noResults');

            //     function filterRPS() {
            //         const searchTerm = searchInput.value.toLowerCase();
            //         const semesterValue = semesterFilter.value;
            //         const tahunValue = tahunFilter.value;
            //         const ownerValue = ownerFilter.value;

            //         let visibleCount = 0;

            //         rpsCards.forEach(card => {
            //             const searchData = card.dataset.search;
            //             const semester = card.dataset.semester;
            //             const tahun = card.dataset.tahun;
            //             const owner = card.dataset.owner;

            //             const matchesSearch = !searchTerm || searchData.includes(searchTerm);
            //             const matchesSemester = !semesterValue || semester === semesterValue;
            //             const matchesTahun = !tahunValue || tahun === tahunValue;
            //             const matchesOwner = !ownerValue || owner === ownerValue;

            //             if (matchesSearch && matchesSemester && matchesTahun && matchesOwner) {
            //                 card.style.display = 'block';
            //                 visibleCount++;
            //             } else {
            //                 card.style.display = 'none';
            //             }
            //         });

            //         // Show/hide no results message
            //         if (visibleCount === 0 && rpsCards.length > 0) {
            //             rpsContainer.style.display = 'none';
            //             noResults.classList.remove('hidden');
            //         } else {
            //             rpsContainer.style.display = 'grid';
            //             noResults.classList.add('hidden');
            //         }
            //     }

            //     // Add event listeners
            //     searchInput.addEventListener('input', filterRPS);
            //     semesterFilter.addEventListener('change', filterRPS);
            //     tahunFilter.addEventListener('change', filterRPS);
            //     ownerFilter.addEventListener('change', filterRPS);
            // });

            // BARU
            // Search, filter, and sort functionality
            document.addEventListener('DOMContentLoaded', function () {
                const searchInput = document.getElementById('searchRPS');
                const semesterFilter = document.getElementById('filterSemester');
                const tahunFilter = document.getElementById('filterTahun');
                const ownerFilter = document.getElementById('filterOwner');
                const statusFilter = document.getElementById('filterStatus');
                const sortSelect = document.getElementById('sortRPS');

                const rpsContainer = document.getElementById('rpsContainer');
                const noResults = document.getElementById('noResults');
                const rpsCards = Array.from(document.querySelectorAll('.rps-card'));

                function sortRPS() {
                    if (!rpsContainer) return;

                    const sortValue = sortSelect.value;

                    const sortedCards = [...rpsCards].sort((a, b) => {
                        const namaA = a.dataset.nama || '';
                        const namaB = b.dataset.nama || '';

                        const tanggalA = new Date(a.dataset.tanggal || '1970-01-01');
                        const tanggalB = new Date(b.dataset.tanggal || '1970-01-01');

                        if (sortValue === 'terbaru') {
                            return tanggalB - tanggalA;
                        }

                        if (sortValue === 'terlama') {
                            return tanggalA - tanggalB;
                        }

                        if (sortValue === 'nama_az') {
                            return namaA.localeCompare(namaB);
                        }

                        if (sortValue === 'nama_za') {
                            return namaB.localeCompare(namaA);
                        }

                        return 0;
                    });

                    sortedCards.forEach(card => {
                        rpsContainer.appendChild(card);
                    });
                }

                function filterRPS() {
                    const searchTerm = searchInput.value.toLowerCase();
                    const semesterValue = semesterFilter.value;
                    const tahunValue = tahunFilter.value;
                    const ownerValue = ownerFilter.value;
                    const statusValue = statusFilter ? statusFilter.value : '';

                    let visibleCount = 0;

                    sortRPS();

                    rpsCards.forEach(card => {
                        const searchData = card.dataset.search || '';
                        const semester = card.dataset.semester;
                        const tahun = card.dataset.tahun;
                        const owner = card.dataset.owner;
                        const status = card.dataset.status || '';

                        const matchesSearch = !searchTerm || searchData.includes(searchTerm);
                        const matchesSemester = !semesterValue || semester === semesterValue;
                        const matchesTahun = !tahunValue || tahun === tahunValue;
                        const matchesOwner = !ownerValue || owner === ownerValue;
                        const matchesStatus = !statusValue || status === statusValue;

                        if (matchesSearch && matchesSemester && matchesTahun && matchesOwner && matchesStatus) {
                            card.style.display = 'block';
                            visibleCount++;
                        } else {
                            card.style.display = 'none';
                        }
                    });

                    if (visibleCount === 0 && rpsCards.length > 0) {
                        rpsContainer.style.display = 'none';
                        noResults.classList.remove('hidden');
                    } else {
                        rpsContainer.style.display = 'grid';
                        noResults.classList.add('hidden');
                    }
                }

                searchInput.addEventListener('input', filterRPS);
                semesterFilter.addEventListener('change', filterRPS);
                tahunFilter.addEventListener('change', filterRPS);
                ownerFilter.addEventListener('change', filterRPS);
                if (statusFilter) statusFilter.addEventListener('change', filterRPS);
                sortSelect.addEventListener('change', filterRPS);

                filterRPS();
            });

            // Admin delete function with additional confirmation
            function deleteRpsAdmin(el) {
                const id = el.getAttribute('data-id');
                const name = el.getAttribute('data-name');
                const owner = el.getAttribute('data-owner');

                Swal.fire({
                    title: 'Konfirmasi Hapus RPS',
                    html: `
            <div class="text-left">
                <p class="mb-2"><strong>Nama RPS:</strong> ${name}</p>
                <p class="mb-4"><strong>Pembuat:</strong> ${owner}</p>
                <p class="text-red-600">Apakah Anda yakin ingin menghapus RPS ini?</p>
                <p class="text-sm text-gray-500 mt-2">Tindakan ini tidak dapat dibatalkan.</p>
            </div>
        `,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Ya, Hapus!',
                    cancelButtonText: 'Batal'
                }).then((result) => {
                    if (result.isConfirmed) {
                        fetch('/delete-rps/' + id, {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' }
                        })
                            .then(res => res.json())
                            .then(data => {
                                if (data.success) {
                                    Swal.fire({
                                        icon: 'success',
                                        title: 'RPS berhasil dihapus',
                                        showConfirmButton: false,
                                        timer: 1500
                                    });
                                    // Remove card from DOM
                                    el.closest('.rps-card').remove();

                                    // Update statistics
                                    setTimeout(() => {
                                        window.location.reload();
                                    }, 1500);
                                } else {
                                    Swal.fire('Gagal', data.message || 'Gagal menghapus RPS', 'error');
                                }
                            })
                            .catch(error => {
                                console.error('Error:', error);
                                Swal.fire('Error', 'Terjadi kesalahan saat menghapus RPS', 'error');
                            });
                    }
                });
            }

            // Admin duplicate function
            function duplicateRpsAdmin(el) {
                const id = el.getAttribute('data-id');
                const name = el.getAttribute('data-name');
                const owner = el.getAttribute('data-owner');

                Swal.fire({
                    title: 'Duplikat RPS',
                    html: `
            <div class="text-left">
                <p class="mb-2"><strong>Nama RPS:</strong> ${name}</p>
                <p class="mb-2"><strong>Pembuat:</strong> ${owner}</p>
                <p class="text-gray-600">Apakah Anda ingin membuat salinan RPS ini?</p>
            </div>
        `,
                    icon: 'question',
                    showCancelButton: true,
                    confirmButtonText: 'Ya, Duplikat',
                    cancelButtonText: 'Batal'
                }).then(result => {
                    if (!result.isConfirmed) return;

                    fetch('/duplicate-rps/' + id, {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' }
                    })
                        .then(res => res.json())
                        .then(data => {
                            if (data && data.success) {
                                Swal.fire({
                                    icon: 'success',
                                    title: 'RPS berhasil diduplikasi',
                                    showConfirmButton: false,
                                    timer: 1400
                                });
                                setTimeout(() => { window.location.reload(); }, 1400);
                            } else {
                                Swal.fire('Gagal', data.message || 'Gagal menduplikasi RPS', 'error');
                            }
                        })
                        .catch(err => {
                            console.error('Duplicate error', err);
                            Swal.fire('Error', 'Terjadi kesalahan saat menduplikasi RPS', 'error');
                        });
                });
            }

            // Success message handling
            if (window.location.search.includes('saved=1')) {
                Swal.fire({
                    icon: 'success',
                    title: 'Data telah disimpan',
                    showConfirmButton: false,
                    timer: 1800
                });
            }

            if (window.location.search.includes('updated=1')) {
                Swal.fire({
                    icon: 'success',
                    title: 'RPS berhasil diperbarui',
                    showConfirmButton: false,
                    timer: 1800
                });
            }
        </script>