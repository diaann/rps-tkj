<%- include('partials/header') %>

    <div class="container-custom">
        <div class="card mb-6">
            <h1 class="text-2xl font-bold text-gray-800 mb-2">Tabel Penilaian</h1>
            <p class="text-gray-600">
                <span class="font-semibold"><%= rpsItem.nama_mk %></span>
                &middot; Semester <%= rpsItem.semester %>
                &middot; Kelas <%= kelas.nama %>
            </p>
        </div>

        <% if (saved) { %>
            <div class="mb-4 p-3 rounded bg-green-100 text-green-800 border border-green-300">
                <i class="fas fa-check-circle mr-1"></i> Nilai berhasil disimpan.
            </div>
        <% } %>

        <% if (subCpmkList.length === 0) { %>
            <div class="card text-center py-8 text-gray-500">
                RPS ini belum punya data Sub-CPMK. Lengkapi dulu lewat Edit RPS.
            </div>
        <% } else if (mahasiswaList.length === 0) { %>
            <div class="card text-center py-8 text-gray-500">
                Belum ada data mahasiswa untuk kelas <%= kelas.nama %>.
            </div>
        <% } else { %>

        <!-- PENTING: cuma ADA 1 <form> di seluruh halaman ini, membungkus SEMUA tab
             Sub-CPMK sekaligus (tab-tab-nya cuma disembunyiin/ditampilin pakai css,
             bukan form terpisah-terpisah). jadi walau user cuma keliatan lagi ngisi
             1 tab doang, pas tombol "Simpan Nilai" diklik, NILAI DARI SEMUA TAB
             ikut terkirim bareng ke server sekali jalan. -->
        <form method="POST" action="/penilaian/mk/<%= rpsItem.id %>/kelas/<%= kelas.id %>/save">
            <input type="hidden" name="activeTab" id="active-tab-input" value="<%= (typeof activeTab !== 'undefined' && activeTab) ? activeTab : 'tb-panel-1' %>">

            <!-- Tab navigation -->
            <div class="card">
                <div class="flex flex-wrap gap-2 -mb-px">
                    <% subCpmkList.forEach(function(sub, idx) { %>
                        <button type="button"
                            class="penilaian-tab-btn px-4 py-2 text-sm font-medium rounded-t-lg border border-b-0 <%= (typeof activeTab !== 'undefined' && activeTab === 'tb-panel-' + sub.globalNumber) ? 'bg-white border-blue-500 text-blue-700' : 'bg-gray-50 border-transparent text-gray-500 hover:text-blue-600' %>"
                            data-tab-target="tb-panel-<%= sub.globalNumber %>"
                            onclick="showPenilaianTab('tb-panel-<%= sub.globalNumber %>', this)">
                            Sub-CPMK <%= sub.globalNumber %>
                        </button>
                    <% }); %>
                    <!--Tabel Rekap will always be shown as the last tab.-->
                    <button type="button"
                        class="penilaian-tab-btn px-4 py-2 text-sm font-medium rounded-t-lg border border-b-0 <%= (typeof activeTab !== 'undefined' && activeTab === 'tb-panel-rekap') ? 'bg-white border-blue-500 text-blue-700' : 'bg-gray-50 border-transparent text-gray-500 hover:text-blue-600' %>"
                        data-tab-target="tb-panel-rekap"
                        onclick="showPenilaianTab('tb-panel-rekap', this)">
                        Rekap
                    </button>
                </div>

                <% subCpmkList.forEach(function(sub, idx) { %>
                    <%
                        // Kolom sumatif tetap (Kuis/Tugas/Ujian/PjBL/Presentasi) cuma
                        // ditampilkan kalau Sub-CPMK ini memang punya bobot untuk
                        // kategori tsb -- kalau tidak, kolomnya cuma kosong percuma
                        // (RPS-nya sendiri tidak memakai kategori itu di minggu ini).
                        const sumatifCols = [
                            { key: 'kuis', label: 'Kuis', nama: sub.kuisNama, bobot: sub.kuisBobot },
                            { key: 'tugas', label: 'Tugas', nama: sub.tugasNama, bobot: sub.tugasBobot },
                            { key: 'ujian', label: 'Ujian', nama: sub.ujianNama, bobot: sub.ujianBobot },
                            { key: 'pjbl', label: 'PjBL', nama: sub.pjblNama, bobot: sub.pjblBobot },
                            { key: 'presentasi', label: 'Presentasi', nama: sub.presentasiNama, bobot: sub.presentasiBobot }
                        ].filter(function(col) { return col.bobot; });
                    %>
                    <div id="tb-panel-<%= sub.globalNumber %>" class="penilaian-tab-panel <%= (typeof activeTab !== 'undefined' && activeTab === 'tb-panel-' + sub.globalNumber) ? '' : 'hidden' %>">

                        <div class="mb-4 p-4 bg-gray-50 border rounded-lg">
                            <div class="text-sm text-gray-500 mb-2">Pekan <%= sub.pekanAwal %><% if (sub.pekanAkhir && sub.pekanAkhir !== sub.pekanAwal) { %> - <%= sub.pekanAkhir %><% } %></div>
                            <div class="text-gray-800 mb-3"><%= sub.deskripsi %></div>
                            <div class="flex flex-wrap gap-2 text-sm">
                                <span class="px-3 py-1 rounded-full bg-green-100 text-green-700">
                                    Formatif: <%= sub.formatifNama || '-' %><% if (sub.formatifBobot) { %> (<%= sub.formatifBobot %>%)<% } %>
                                </span>
                                <% sumatifCols.forEach(function(col) { %>
                                <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-700">
                                    <%= col.label %>: <%= col.nama || '-' %> (<%= col.bobot %>%)
                                </span>
                                <% }); %>
                                <% (sub.lainnya || []).forEach(function(item) { %>
                                <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-700">
                                    <%= item.nama || 'Lainnya' %><% if (item.bobot) { %> (<%= item.bobot %>%)<% } %>
                                </span>
                                <% }); %>
                            </div>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="table-auto w-full border-collapse">
                                <thead class="bg-blue-50">
                                    <tr>
                                        <th class="px-3 py-2 border text-left text-xs font-semibold">No</th>
                                        <th class="px-3 py-2 border text-left text-xs font-semibold">NIM</th>
                                        <th class="px-3 py-2 border text-left text-xs font-semibold">Nama Mahasiswa</th>
                                        <th class="px-3 py-2 border text-center text-xs font-semibold">Formatif</th>
                                        <% sumatifCols.forEach(function(col) { %>
                                        <th class="px-3 py-2 border text-center text-xs font-semibold"><%= col.label %></th>
                                        <% }); %>
                                        <% (sub.lainnya || []).forEach(function(item) { %>
                                        <th class="px-3 py-2 border text-center text-xs font-semibold"><%= item.nama || 'Lainnya' %></th>
                                        <% }); %>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200">
                                    <% mahasiswaList.forEach(function(m, mIdx) { %>
                                        <% const base = `nilai[${sub.globalNumber}][${m.id}]`; // awalan nama field nilai utk 1 mahasiswa %>
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-3 py-2 border text-sm"><%= mIdx + 1 %></td>
                                            <td class="px-3 py-2 border text-sm"><%= m.nim %></td>
                                            <td class="px-3 py-2 border text-sm"><%= m.nama %></td>
                                            <!-- name="...[formatif]" -- inilah nama field yg beneran dikirim ke
                                                 server pas form disubmit, misal jadi "nilai[3][mhs007][formatif]".
                                                 value=... ngambil dari savedValues (nilai yg udah pernah
                                                 disimpan sebelumnya), jadi form otomatis "keinget" nilai lama. -->
                                            <td class="px-2 py-1 border">
                                                <input type="number" min="0" max="100" step="0.01"
                                                    name="<%= base %>[formatif]"
                                                    value="<%= savedValues[base + '[formatif]'] || '' %>"
                                                    class="w-full border rounded px-2 py-1 text-sm text-center">
                                            </td>
                                            <% sumatifCols.forEach(function(col) { %>
                                            <td class="px-2 py-1 border">
                                                <input type="number" min="0" max="100" step="0.01"
                                                    name="<%= base %>[<%= col.key %>]"
                                                    value="<%= savedValues[base + '[' + col.key + ']'] || '' %>"
                                                    class="w-full border rounded px-2 py-1 text-sm text-center">
                                            </td>
                                            <% }); %>
                                            <% (sub.lainnya || []).forEach(function(item, lIdx) { %>
                                            <td class="px-2 py-1 border">
                                                <input type="number" min="0" max="100" step="0.01"
                                                    name="<%= base %>[lainnya][<%= lIdx %>]"
                                                    value="<%= savedValues[base + '[lainnya][' + lIdx + ']'] || '' %>"
                                                    class="w-full border rounded px-2 py-1 text-sm text-center">
                                            </td>
                                            <% }); %>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% }); %>

                <div id="tb-panel-rekap" class="penilaian-tab-panel <%= (typeof activeTab !== 'undefined' && activeTab === 'tb-panel-rekap') ? '' : 'hidden' %>">
                    <div class="mb-4 p-4 bg-gray-50 border rounded-lg">
                        <div class="text-gray-800">Ringkasan nilai akhir per komponen berdasarkan data yang sudah di input pada semua tab Sub-CPMK.</div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="table-auto w-full border-collapse">
                            <thead class="bg-blue-50">
                                <tr>
                                    <th class="px-3 py-2 border text-left text-xs font-semibold">No</th>
                                    <th class="px-3 py-2 border text-left text-xs font-semibold">NIM</th>
                                    <th class="px-3 py-2 border text-left text-xs font-semibold">Nama Mahasiswa</th>
                                    <th class="px-3 py-2 border text-left text-xs font-semibold">Komponen</th>
                                    <th class="px-3 py-2 border text-center text-xs font-semibold">Nilai Akhir</th>
                                    <th class="px-3 py-2 border text-center text-xs font-semibold">Status</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                <% (typeof rekapData !== 'undefined' && Array.isArray(rekapData) ? rekapData : []).forEach(function(item, idx) { %>
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-3 py-2 border text-sm"><%= idx + 1 %></td>
                                        <td class="px-3 py-2 border text-sm"><%= item.nim %></td>
                                        <td class="px-3 py-2 border text-sm"><%= item.nama %></td>
                                        <td class="px-3 py-2 border text-sm">
                                            <select class="w-full border rounded px-2 py-1 text-sm" data-student-id="<%= item.id %>" onchange="updateRekapRow(this)">
                                                <% (typeof rekapComponents !== 'undefined' && Array.isArray(rekapComponents) ? rekapComponents : []).forEach(function(option) { %>
                                                    <% const optionScore = item.componentScores && item.componentScores[option.key] ? item.componentScores[option.key] : {}; %>
                                                    <option value="<%= option.key %>"
                                                        data-score="<%= optionScore.nilaiAkhir || 0 %>"
                                                        data-status="<%= optionScore.status || 'Belum dinilai' %>"
                                                        <%= option.key === item.selectedComponentKey ? 'selected' : '' %>>
                                                        <%= option.label %>
                                                    </option>
                                                <% }); %>
                                            </select>
                                        </td>
                                        <td class="px-3 py-2 border text-sm text-center" data-rekap-score-cell="<%= item.id %>"><%= isNaN(item.selectedNilaiAkhir) ? '0.00' : Number(item.selectedNilaiAkhir).toFixed(2) %></td>
                                        <td class="px-3 py-2 border text-sm text-center" data-rekap-status-cell="<%= item.id %>">
                                            <span class="px-2 py-1 rounded-full text-xs font-medium <%= item.selectedStatus === 'Lulus' ? 'bg-green-100 text-green-700' : item.selectedStatus === 'Remedial' ? 'bg-yellow-100 text-yellow-700' : 'bg-gray-100 text-gray-700' %>">
                                                <%= item.selectedStatus %>
                                            </span>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="mt-4 flex justify-between items-center">
                <a href="/penilaian" class="btn-secondary px-4 py-2 rounded bg-gray-500 text-white hover:bg-gray-600 inline-block">Kembali</a>
                <button type="submit" class="btn-primary px-6 py-2 rounded">
                    <i class="fas fa-save mr-1"></i>Simpan Nilai
                </button>
            </div>
        </form>

        <% } %>

        <% if (subCpmkList.length === 0 || mahasiswaList.length === 0) { %>
        <a href="/penilaian" class="btn-secondary mt-4 px-4 py-2 rounded bg-gray-500 text-white hover:bg-gray-600 inline-block">Kembali</a>
        <% } %>
    </div>

    <script>
        function updateRekapRow(selectEl) {
            const studentId = selectEl.getAttribute('data-student-id');
            const selectedOption = selectEl.options[selectEl.selectedIndex];
            const scoreCell = document.querySelector('[data-rekap-score-cell="' + studentId + '"]');
            const statusCell = document.querySelector('[data-rekap-status-cell="' + studentId + '"]');

            if (!selectedOption) {
                return;
            }

            const score = selectedOption.getAttribute('data-score');
            const status = selectedOption.getAttribute('data-status');

            if (scoreCell) {
                scoreCell.textContent = Number(score || 0).toFixed(2);
            }

            if (statusCell) {
                const statusClass = status === 'Lulus'
                    ? 'bg-green-100 text-green-700'
                    : status === 'Remedial'
                        ? 'bg-yellow-100 text-yellow-700'
                        : 'bg-gray-100 text-gray-700';
                statusCell.innerHTML = '<span class="px-2 py-1 rounded-full text-xs font-medium ' + statusClass + '">' + status + '</span>';
            }
        }

        // ganti tab Sub-CPMK yg aktif; semua tab tetap 1 <form> yg sama jadi nilai ga hilang pas pindah tab
        function showPenilaianTab(targetId, btnEl) {
            document.querySelectorAll('.penilaian-tab-panel').forEach(function (panel) {
                panel.classList.add('hidden');
            });
            document.querySelectorAll('.penilaian-tab-btn').forEach(function (btn) {
                btn.classList.remove('bg-white', 'border-blue-500', 'text-blue-700');
                btn.classList.add('bg-gray-50', 'border-transparent', 'text-gray-500');
            });
            const target = document.getElementById(targetId);
            if (target) target.classList.remove('hidden');
            if (btnEl) {
                btnEl.classList.remove('bg-gray-50', 'border-transparent', 'text-gray-500');
                btnEl.classList.add('bg-white', 'border-blue-500', 'text-blue-700');
            }

            const hiddenInput = document.getElementById('active-tab-input');
            if (hiddenInput) {
                hiddenInput.value = targetId;
            }
        }
    </script>

<%- include('partials/footer') %>
