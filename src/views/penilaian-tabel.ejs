<%- include('partials/header') %>

    <div class="container-custom">
        <div class="card mb-6">
            <h1 class="text-2xl font-bold text-gray-800 mb-2">Tabel Penilaian</h1>
            <p class="text-gray-600">
                <span class="font-semibold"><%= rpsItem.nama_mk %></span>
                &middot; Semester <%= rpsItem.semester %>
                &middot; Kelas <%= kelasLabel %>
            </p>
        </div>

        <% if (saved) { %>
            <div class="mb-4 p-3 rounded bg-green-100 text-green-800 border border-green-300">
                <i class="fas fa-check-circle mr-1"></i> Nilai berhasil disimpan.
            </div>
        <% } %>

        <% if (subCpmkList.length === 0) { %>
            <div class="card text-center py-8 text-gray-500">
                RPS ini belum punya data Sub-CPMK. Lengkapi dulu lewat Edit RPS.
            </div>
        <% } else if (mahasiswaList.length === 0) { %>
            <div class="card text-center py-8 text-gray-500">
                Belum ada data mahasiswa untuk kelas <%= kelasLabel %>.
            </div>
        <% } else { %>

        <!-- Matriks Asesmen RPS Collapsible Card -->
        <div class="card mb-6 shadow-sm border border-gray-100">
            <div class="flex justify-between items-center border-b pb-3 mb-4 cursor-pointer" onclick="toggleRpsMatrix()">
                <h2 class="text-md font-bold text-gray-800 flex items-center">
                    <i class="fas fa-table mr-2 text-blue-600"></i> Matriks Asesmen RPS (Rencana Pembelajaran Semester)
                </h2>
                <button type="button" id="toggle-matrix-btn" class="text-blue-600 hover:text-blue-800 text-sm font-semibold flex items-center gap-1 focus:outline-none">
                    <span id="toggle-matrix-text">Tampilkan</span> <i id="toggle-matrix-icon" class="fas fa-chevron-down"></i>
                </button>
            </div>
            
            <div id="rps-matrix-container" class="transition-all duration-300 hidden">
                <div class="overflow-x-auto">
                    <table class="table-auto w-full border-collapse border border-gray-200">
                        <thead class="bg-blue-50 text-gray-700">
                            <tr>
                                <th rowspan="2" class="px-3 py-2 border border-gray-300 text-center text-xs font-bold uppercase tracking-wider">KODE CPL</th>
                                <th rowspan="2" class="px-3 py-2 border border-gray-300 text-center text-xs font-bold uppercase tracking-wider">KODE CPMK</th>
                                <th rowspan="2" class="px-3 py-2 border border-gray-300 text-center text-xs font-bold uppercase tracking-wider">KODE Sub-CPMK</th>
                                <th rowspan="2" class="px-3 py-2 border border-gray-300 text-center text-xs font-bold uppercase tracking-wider">Bentuk dan Metode Pembelajaran</th>
                                <th colspan="<%= 1 + (typeof activeSumatifCols !== 'undefined' ? activeSumatifCols.length : 0) %>" class="px-3 py-1 border border-gray-300 text-center text-xs font-bold uppercase tracking-wider">Bentuk dan Teknik Penilaian</th>
                                <th rowspan="2" class="px-3 py-2 border border-gray-300 text-center text-xs font-bold uppercase tracking-wider">Bobot Penilaian (%)</th>
                            </tr>
                            <tr>
                                <th class="px-3 py-1 border border-gray-300 text-center text-xs font-bold uppercase tracking-wider bg-green-50">FORMATIF</th>
                                <% if (typeof activeSumatifCols !== 'undefined') { %>
                                    <% activeSumatifCols.forEach(function(col) { %>
                                        <th class="px-3 py-1 border border-gray-300 text-center text-xs font-bold uppercase tracking-wider bg-blue-100"><%= col.label %></th>
                                    <% }); %>
                                <% } %>
                            </tr>
                        </thead>
                        <tbody class="divide-y divide-gray-200 text-sm text-gray-800">
                            <% 
                               let totalBobotPenilaian = 0;
                               subCpmkList.forEach(function(sub) { 
                                   let rowSumatifBobot = 0;
                                   rowSumatifBobot += (parseFloat(sub.tugasBobot) || 0);
                                   rowSumatifBobot += (parseFloat(sub.kuisBobot) || 0);
                                   rowSumatifBobot += (parseFloat(sub.presentasiBobot) || 0);
                                   rowSumatifBobot += (parseFloat(sub.pjblBobot) || 0);
                                   rowSumatifBobot += (parseFloat(sub.ujianBobot) || 0);
                                   (sub.lainnya || []).forEach(function(item) {
                                       rowSumatifBobot += (parseFloat(item.bobot) || 0);
                                   });
                                   totalBobotPenilaian += rowSumatifBobot;
                            %>
                                <tr class="hover:bg-gray-50">
                                    <% if (typeof sub.cplRowSpan !== 'undefined') { %>
                                        <% if (sub.cplRowSpan > 0) { %>
                                            <td rowspan="<%= sub.cplRowSpan %>" class="px-3 py-2 border border-gray-200 text-center font-semibold bg-white align-middle">
                                                <%= sub.cplCode || '-' %>
                                            </td>
                                        <% } %>
                                    <% } else { %>
                                        <td class="px-3 py-2 border border-gray-200 text-center font-semibold bg-white align-middle">
                                            <%= sub.cplCode || '-' %>
                                        </td>
                                    <% } %>
                                    
                                    <% if (typeof sub.cpmkRowSpan !== 'undefined') { %>
                                        <% if (sub.cpmkRowSpan > 0) { %>
                                            <td rowspan="<%= sub.cpmkRowSpan %>" class="px-3 py-2 border border-gray-200 text-center font-semibold bg-white align-middle">
                                                <%= sub.cpmkId || '-' %>
                                            </td>
                                        <% } %>
                                    <% } else { %>
                                        <td class="px-3 py-2 border border-gray-200 text-center font-semibold bg-white align-middle">
                                            <%= sub.cpmkId || '-' %>
                                        </td>
                                    <% } %>
                                    
                                    <td class="px-3 py-2 border border-gray-200 text-center font-medium">
                                        Sub-CPMK <%= sub.globalNumber %>
                                    </td>
                                    
                                    <td class="px-3 py-2 border border-gray-200 text-left text-xs leading-relaxed max-w-xs">
                                        <%
                                            let bp = (sub.bentukPembelajaran || '').trim();
                                            let mp = (sub.metode || sub.metodeLuring || sub.metodeDaring || '').trim();
                                            let displayPemb = [];
                                            if (bp) displayPemb.push('BP: ' + bp);
                                            if (mp) displayPemb.push('MP: ' + mp);
                                        %>
                                        <%= displayPemb.join(', ') || '-' %>
                                    </td>
                                    
                                    <% if (typeof sub.formatifRowSpan !== 'undefined') { %>
                                        <% if (sub.formatifRowSpan > 0) { %>
                                            <td rowspan="<%= sub.formatifRowSpan %>" class="px-3 py-2 border border-gray-200 text-left text-xs bg-white align-middle">
                                                <%= sub.formatifNama || '-' %><% if (sub.formatifBobot) { %> (<%= sub.formatifBobot %>%)<% } %>
                                            </td>
                                        <% } %>
                                    <% } else { %>
                                        <td class="px-3 py-2 border border-gray-200 text-left text-xs bg-white align-middle">
                                            <%= sub.formatifNama || '-' %><% if (sub.formatifBobot) { %> (<%= sub.formatifBobot %>%)<% } %>
                                        </td>
                                    <% } %>
                                    
                                    <% if (typeof activeSumatifCols !== 'undefined') { %>
                                        <% activeSumatifCols.forEach(function(col) { %>
                                            <td class="px-3 py-2 border border-gray-200 text-center text-xs">
                                                <% if (col.isDynamic) { %>
                                                    <% 
                                                       let foundItem = (sub.lainnya || []).find(function(item) {
                                                           return item.nama && item.nama.replace(/\s*\d+\s*$/, '').trim().toLowerCase() === col.rawName.toLowerCase();
                                                       });
                                                       if (foundItem) {
                                                    %>
                                                        <%= foundItem.nama %> (<%= foundItem.bobot %>%)
                                                    <% } else { %>
                                                        -
                                                    <% } %>
                                                <% } else { %>
                                                    <% 
                                                       let nameField = col.key + 'Nama';
                                                       let bobotField = col.key + 'Bobot';
                                                       if (sub[bobotField] && parseFloat(sub[bobotField]) > 0) {
                                                    %>
                                                        <%= sub[nameField] || col.label %> (<%= sub[bobotField] %>%)
                                                    <% } else { %>
                                                        -
                                                    <% } %>
                                                <% } %>
                                            </td>
                                        <% }); %>
                                    <% } %>
                                    
                                    <td class="px-3 py-2 border border-gray-200 text-center font-semibold bg-gray-50">
                                        <%= rowSumatifBobot %>%
                                    </td>
                                </tr>
                            <% }); %>
                            <!-- Total Row -->
                            <tr class="bg-gray-100 font-bold text-gray-900">
                                <td colspan="4" class="px-3 py-2 border border-gray-300 text-right">TOTAL</td>
                                <td colspan="<%= 1 + (typeof activeSumatifCols !== 'undefined' ? activeSumatifCols.length : 0) %>" class="px-3 py-2 border border-gray-300"></td>
                                <td class="px-3 py-2 border border-gray-300 text-center"><%= totalBobotPenilaian %>%</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <!-- PENTING: cuma ADA 1 <form> di seluruh halaman ini, membungkus SEMUA tab
             Sub-CPMK sekaligus (tab-tab-nya cuma ditampilkan menggunakan css). 
             jadi walau user cuma keliatan cuma mengisi 1 tab , setelah tombol 
             "Simpan Nilai" diklik, NILAI DARI SEMUA TAB ikut terkirim ke server. -->
        <form id="penilaian-form" method="POST" action="/penilaian/mk/<%= rpsItem.id %>/kelas/<%= kelas.id %>/save">
            <input type="hidden" name="activeTab" id="active-tab-input" value="<%= (typeof activeTab !== 'undefined' && activeTab) ? activeTab : 'tb-panel-1' %>">

            <!-- Tab navigation -->
            <div class="card">
                <div class="flex flex-wrap gap-2 -mb-px">
                    <% subCpmkList.forEach(function(sub, idx) { %>
                        <button type="button"
                            class="penilaian-tab-btn px-4 py-2 text-sm font-medium rounded-t-lg border border-b-0 <%= (typeof activeTab !== 'undefined' && activeTab === 'tb-panel-' + sub.globalNumber) ? 'bg-white border-blue-500 text-blue-700' : 'bg-gray-50 border-transparent text-gray-500 hover:text-blue-600' %>"
                            data-tab-target="tb-panel-<%= sub.globalNumber %>"
                            onclick="showPenilaianTab('tb-panel-<%= sub.globalNumber %>', this)">
                            Sub-CPMK <%= sub.globalNumber %>
                        </button>
                    <% }); %>
                    <!--Tabel Rekap will always be shown as the last tab.-->
                    <button type="button"
                        class="penilaian-tab-btn px-4 py-2 text-sm font-medium rounded-t-lg border border-b-0 <%= (typeof activeTab !== 'undefined' && activeTab === 'tb-panel-rekap') ? 'bg-white border-blue-500 text-blue-700' : 'bg-gray-50 border-transparent text-gray-500 hover:text-blue-600' %>"
                        data-tab-target="tb-panel-rekap"
                        onclick="showPenilaianTab('tb-panel-rekap', this)">
                        Rekap
                    </button>
                </div>

                <% subCpmkList.forEach(function(sub, idx) { %>
                    <%
                        // Kolom sumatif tetap (Kuis/Tugas/Ujian/PjBL/Presentasi) cuma
                        // ditampilkan kalau Sub-CPMK ini memang punya bobot untuk
                        // kategori tsb -- kalau tidak, kolomnya cuma kosong percuma
                        // (RPS-nya sendiri tidak memakai kategori itu di minggu ini).
                        const sumatifCols = [
                            { key: 'kuis', label: 'Kuis', nama: sub.kuisNama, bobot: sub.kuisBobot },
                            { key: 'tugas', label: 'Tugas', nama: sub.tugasNama, bobot: sub.tugasBobot },
                            { key: 'ujian', label: 'Ujian', nama: sub.ujianNama, bobot: sub.ujianBobot },
                            { key: 'pjbl', label: 'PjBL', nama: sub.pjblNama, bobot: sub.pjblBobot },
                            { key: 'presentasi', label: 'Presentasi', nama: sub.presentasiNama, bobot: sub.presentasiBobot }
                        ].filter(function(col) { return col.bobot; });
                    %>
                    <div id="tb-panel-<%= sub.globalNumber %>" class="penilaian-tab-panel <%= (typeof activeTab !== 'undefined' && activeTab === 'tb-panel-' + sub.globalNumber) ? '' : 'hidden' %>">

                        <div class="mb-4 p-4 bg-gray-50 border rounded-lg">
                            <div class="text-sm text-gray-500 mb-2">Pekan <%= sub.pekanAwal %><% if (sub.pekanAkhir && sub.pekanAkhir !== sub.pekanAwal) { %> - <%= sub.pekanAkhir %><% } %></div>
                            <div class="text-gray-800 mb-3"><%= sub.deskripsi %></div>
                            <div class="flex flex-wrap gap-2 text-sm">
                                <span class="px-3 py-1 rounded-full bg-green-100 text-green-700">
                                    Formatif: <%= sub.formatifNama || '-' %><% if (sub.formatifBobot) { %> (<%= sub.formatifBobot %>%)<% } %>
                                </span>
                                <% sumatifCols.forEach(function(col) { %>
                                <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-700">
                                    <%= col.label %>: <%= col.nama || '-' %> (<%= col.bobot %>%)
                                </span>
                                <% }); %>
                                <% (sub.lainnya || []).forEach(function(item) { %>
                                <span class="px-3 py-1 rounded-full bg-blue-100 text-blue-700">
                                    <%= item.nama || 'Lainnya' %><% if (item.bobot) { %> (<%= item.bobot %>%)<% } %>
                                </span>
                                <% }); %>
                            </div>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="table-auto w-full border-collapse">
                                <thead class="bg-blue-50">
                                    <tr>
                                        <th class="px-3 py-2 border text-left text-xs font-semibold">No</th>
                                        <th class="px-3 py-2 border text-left text-xs font-semibold">NIM</th>
                                        <th class="px-3 py-2 border text-left text-xs font-semibold">Nama Mahasiswa</th>
                                        <th class="px-3 py-2 border text-center text-xs font-semibold">Formatif</th>
                                        <% sumatifCols.forEach(function(col) { %>
                                        <th class="px-3 py-2 border text-center text-xs font-semibold"><%= col.label %></th>
                                        <% }); %>
                                        <% (sub.lainnya || []).forEach(function(item) { %>
                                        <th class="px-3 py-2 border text-center text-xs font-semibold"><%= item.nama || 'Lainnya' %></th>
                                        <% }); %>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200">
                                    <% mahasiswaList.forEach(function(m, mIdx) { %>
                                        <% const base = `nilai[${sub.globalNumber}][${m.nim}]`; // awalan nama field nilai utk 1 mahasiswa. pakai NIM (bukan id) supaya nilai ga ke-orphan kalau mahasiswa dipindah kelasId %>
                                        <tr class="hover:bg-gray-50">
                                            <td class="px-3 py-2 border text-sm"><%= mIdx + 1 %></td>
                                            <td class="px-3 py-2 border text-sm"><%= m.nim %></td>
                                            <td class="px-3 py-2 border text-sm"><%= m.nama %></td>
                                            <!-- name="...[formatif]" -- inilah nama field yg beneran dikirim ke
                                                 server pas form disubmit, misal jadi "nilai[3][20250101][formatif]".
                                                 value=... ngambil dari savedValues (nilai yg udah pernah
                                                 disimpan sebelumnya), jadi form otomatis "keinget" nilai lama. -->
                                            <td class="px-2 py-1 border">
                                                <input type="number" min="0" max="100" step="0.01"
                                                    name="<%= base %>[formatif]"
                                                    value="<%= savedValues[base + '[formatif]'] || '' %>"
                                                    class="w-full border rounded px-2 py-1 text-sm text-center">
                                            </td>
                                            <% sumatifCols.forEach(function(col) { %>
                                            <td class="px-2 py-1 border">
                                                <input type="number" min="0" max="100" step="0.01"
                                                    name="<%= base %>[<%= col.key %>]"
                                                    value="<%= savedValues[base + '[' + col.key + ']'] || '' %>"
                                                    class="w-full border rounded px-2 py-1 text-sm text-center">
                                            </td>
                                            <% }); %>
                                            <% (sub.lainnya || []).forEach(function(item, lIdx) { %>
                                            <td class="px-2 py-1 border">
                                                <input type="number" min="0" max="100" step="0.01"
                                                    name="<%= base %>[lainnya][<%= lIdx %>]"
                                                    value="<%= savedValues[base + '[lainnya][' + lIdx + ']'] || '' %>"
                                                    class="w-full border rounded px-2 py-1 text-sm text-center">
                                            </td>
                                            <% }); %>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                <% }); %>

                <div id="tb-panel-rekap" class="penilaian-tab-panel <%= (typeof activeTab !== 'undefined' && activeTab === 'tb-panel-rekap') ? '' : 'hidden' %>">
                    <div class="mb-4 p-4 bg-gray-50 border rounded-lg">
                        <div class="text-gray-800">Ringkasan nilai akhir per Sub-CPMK berdasarkan data yang sudah di input di setiap tab.</div>
                    </div>

                    <div class="overflow-x-auto">
                        <table class="table-auto w-full border-collapse">
                            <thead class="bg-blue-50">
                                <tr>
                                    <th class="px-3 py-2 border text-left text-xs font-semibold">No</th>
                                    <th class="px-3 py-2 border text-left text-xs font-semibold">NIM</th>
                                    <th class="px-3 py-2 border text-left text-xs font-semibold">Nama Mahasiswa</th>
                                    <% (typeof rekapColumns !== 'undefined' && Array.isArray(rekapColumns) ? rekapColumns : []).forEach(function(column) { %>
                                        <th class="px-3 py-2 border text-center text-xs font-semibold"><%= column.label %></th>
                                    <% }); %>
                                    <th class="px-3 py-2 border text-center text-xs font-semibold bg-blue-100">Nilai Akhir</th>
                                    <th class="px-3 py-2 border text-center text-xs font-semibold bg-blue-100">Nilai Akhir Huruf</th>
                                    <th class="px-3 py-2 border text-center text-xs font-semibold bg-blue-100">Bobot</th>
                                    <th class="px-3 py-2 border text-center text-xs font-semibold">Portofolio</th>
                                </tr>
                            </thead>
                            <tbody class="divide-y divide-gray-200">
                                <% (typeof rekapData !== 'undefined' && Array.isArray(rekapData) ? rekapData : []).forEach(function(item, idx) { %>
                                    <tr class="hover:bg-gray-50">
                                        <td class="px-3 py-2 border text-sm"><%= idx + 1 %></td>
                                        <td class="px-3 py-2 border text-sm"><%= item.nim %></td>
                                        <td class="px-3 py-2 border text-sm"><%= item.nama %></td>
                                        <% (typeof rekapColumns !== 'undefined' && Array.isArray(rekapColumns) ? rekapColumns : []).forEach(function(column) { %>
                                            <% const scoreData = item.subCpmkScores && item.subCpmkScores[column.key] ? item.subCpmkScores[column.key] : {}; %>
                                            <td class="px-3 py-2 border text-sm text-center">
                                                <div class="font-medium"><%= Math.round(Number(scoreData.nilaiAkhir || 0)) %></div>
                                            </td>
                                        <% }); %>
                                        <td class="px-3 py-2 border text-sm text-center font-semibold bg-blue-50">
                                            <%= Math.round(Number(item.nilaiAkhirKeseluruhan || 0) * 100) / 100 %>
                                        </td>
                                        <td class="px-3 py-2 border text-sm text-center font-semibold bg-blue-50">
                                            <%= item.nilaiAkhirHuruf || '-' %>
                                        </td>
                                        <td class="px-3 py-2 border text-sm text-center font-semibold bg-blue-50">
                                            <%= (typeof item.bobot === 'number') ? item.bobot.toFixed(2) : '-' %>
                                        </td>
                                        <td class="px-3 py-2 border text-sm text-center">
                                            <button type="button" class="btn-secondary text-xs px-3 py-1 rounded"
                                                onclick="openPortofolio('<%= item.nim %>')">
                                                <i class="fas fa-folder-open mr-1"></i>Portofolio
                                            </button>
                                        </td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Modal Portofolio per mahasiswa. Semua modal ini dirender langsung di HTML
                 (bukan diisi lewat javascript) supaya textarea komentarnya tetap bagian
                 dari <form> yg sama & ikut kekirim pas tombol "Simpan Nilai" diklik --
                 sama kayak prinsip tab Sub-CPMK di atas. Disembunyikan pakai class
                 "hidden" & baru dimunculkan lewat openPortofolio(nim). -->
            <% mahasiswaList.forEach(function(m) { %>
                <% const rekapItem = (typeof rekapData !== 'undefined' && Array.isArray(rekapData) ? rekapData : []).find(function(r) { return r.nim === m.nim; }); %>
                <div id="portofolio-modal-<%= m.nim %>" class="portofolio-modal hidden fixed inset-0 z-50 flex items-center justify-center bg-black bg-opacity-50 p-4">
                    <!-- Increased max-width to max-w-4xl for the detailed report table -->
                    <div class="bg-white rounded-lg shadow-xl w-full max-w-4xl" style="max-height: 85vh; display: flex; flex-direction: column;">
                        <div class="flex items-center justify-between p-4 border-b flex-shrink-0">
                            <div>
                                <div class="font-semibold text-gray-800 text-lg"><%= m.nama %></div>
                                <div class="text-sm text-gray-500">NIM <%= m.nim %></div>
                            </div>
                            <button type="button" class="text-gray-400 hover:text-gray-600" onclick="closePortofolio('<%= m.nim %>')">
                                <i class="fas fa-times text-lg"></i>
                            </button>
                        </div>

                        <div class="p-6 overflow-x-auto" style="flex-grow: 1; overflow-y: auto;">
                            <h4 class="font-bold text-gray-800 mb-3 text-sm flex items-center gap-1.5">
                                <i class="fas fa-file-invoice text-blue-600"></i>
                                Ringkasan Capaian Pembelajaran & Portofolio Mahasiswa
                            </h4>
                            
                            <table class="table-auto w-full border-collapse border border-gray-300 text-xs">
                                <thead class="bg-gray-100 text-gray-700">
                                    <tr>
                                        <th class="px-2 py-2 border border-gray-300 text-center font-bold uppercase w-10">No</th>
                                        <th class="px-3 py-2 border border-gray-300 text-left font-bold uppercase">Mata Kuliah</th>
                                        <th class="px-2 py-2 border border-gray-300 text-center font-bold uppercase w-20">Huruf Mutu (HM)</th>
                                        <th class="px-2 py-2 border border-gray-300 text-center font-bold uppercase w-28">Sebutan Mutu (SM)</th>
                                        <th class="px-2 py-2 border border-gray-300 text-center font-bold uppercase w-20">Angka Mutu (AM)</th>
                                        <th class="px-3 py-2 border border-gray-300 text-left font-bold uppercase">Capaian Pembelajaran</th>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200">
                                    <% if (typeof rpsListWithSubCpmk !== 'undefined' && typeof rekapDataByMk !== 'undefined') { %>
                                        <% rpsListWithSubCpmk.forEach(function(mk, idx) { %>
                                            <% 
                                               const mkRekap = rekapDataByMk[mk.id] || [];
                                               const studentMkSummary = mkRekap.find(function(r) { return r.nim === m.nim; });
                                               const displayNilai = studentMkSummary ? (studentMkSummary.nilaiAkhirHuruf || '-') : '-';
                                               const displaySebutan = typeof getSebutanMutu === 'function' ? getSebutanMutu(displayNilai) : '-';
                                               const displayAngka = typeof getAngkaMutu === 'function' ? getAngkaMutu(displayNilai) : '-';
                                               
                                               // Helper to get description
                                               let displayDesc = 'Belum dinilai.';
                                               if (displayNilai && displayNilai !== '-') {
                                                   if (displayNilai === 'A' || displayNilai === 'A-') {
                                                       displayDesc = `Mahasiswa telah unggul dalam menguasai seluruh Capaian Pembelajaran pada mata kuliah ${mk.nama_mk}.`;
                                                   } else if (displayNilai === 'B+' || displayNilai === 'B' || displayNilai === 'B-') {
                                                       displayDesc = `Mahasiswa telah baik dalam menguasai sebagian besar Capaian Pembelajaran pada mata kuliah ${mk.nama_mk}.`;
                                                   } else if (displayNilai === 'C+' || displayNilai === 'C' || displayNilai === 'C-') {
                                                       displayDesc = `Mahasiswa cukup dalam menguasai standar minimal Capaian Pembelajaran pada mata kuliah ${mk.nama_mk}.`;
                                                   } else if (displayNilai === 'D') {
                                                       displayDesc = `Mahasiswa kurang dalam menguasai Capaian Pembelajaran pada mata kuliah ${mk.nama_mk} dan memerlukan bimbingan tambahan.`;
                                                   } else if (displayNilai === 'E') {
                                                       displayDesc = `Mahasiswa tidak menguasai standar minimal Capaian Pembelajaran pada mata kuliah ${mk.nama_mk} dan dinyatakan tidak lulus.`;
                                                   }
                                               }
                                            %>
                                            <tr class="hover:bg-gray-50">
                                                <td class="px-2 py-2 border border-gray-200 text-center"><%= idx + 1 %></td>
                                                <td class="px-3 py-2 border border-gray-200 font-medium text-gray-900">
                                                    <a href="/penilaian/mk/<%= mk.id %>/kelas/<%= kelas.id %>?activeTab=tb-panel-rekap"
                                                        class="text-blue-600 hover:text-blue-800 hover:underline"
                                                        title="Buka Rekap mata kuliah ini">
                                                        <%= mk.nama_mk %> (<%= mk.kode_mk %>)
                                                    </a>
                                                    </td>
                                                <td class="px-2 py-2 border border-gray-200 text-center font-bold text-blue-700 bg-blue-50"><%= displayNilai %></td>
                                                <td class="px-2 py-2 border border-gray-200 text-center font-semibold text-gray-800"><%= displaySebutan %></td>
                                                <td class="px-2 py-2 border border-gray-200 text-center text-gray-600"><%= displayAngka %></td>
                                                <td class="px-3 py-2 border border-gray-200 text-gray-600 leading-relaxed"><%= displayDesc %></td>
                                            </tr>
                                        <% }); %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>

                        <div class="p-4 border-t flex justify-end gap-3 flex-shrink-0">
                        <button type="button" 
                                class="btn-secondary px-4 py-2 rounded bg-blue-600 text-white hover:bg-blue-700 flex items-center gap-2"
                                onclick="downloadPortofolioPDF('<%= m.nim %>', '<%= m.nama %>')">
                            <i class="fas fa-file-pdf"></i> Download PDF
                        </button>
                        <button type="button" 
                                class="btn-secondary px-4 py-2 rounded bg-gray-500 text-white hover:bg-gray-600" 
                                onclick="closePortofolio('<%= m.nim %>')">
                            Tutup
                        </button>
                        </div>
                    </div>
                </div>
            <% }); %>

            <div class="mt-6 flex justify-between items-center">
                <a href="/penilaian" class="btn-secondary px-4 py-2 rounded bg-gray-500 text-white hover:bg-gray-600 inline-block">Kembali</a>
                
                <button type="submit" id="save-button" class="btn-primary px-6 py-2 rounded flex items-center gap-2">
                    <i class="fas fa-save"></i>
                    <span>Simpan Nilai</span>
                </button>
            </div>
        </form>

        <% } %>

        <% if (subCpmkList.length === 0 || mahasiswaList.length === 0) { %>
        <a href="/penilaian" class="btn-secondary mt-4 px-4 py-2 rounded bg-gray-500 text-white hover:bg-gray-600 inline-block">Kembali</a>
        <% } %>
    </div>

    // Library for PDF donwload
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>

    <script>
        // ganti tab Sub-CPMK yg aktif; semua tab tetap 1 <form> yg sama jadi nilai ga hilang pas pindah tab
        function showPenilaianTab(targetId, btnEl) {
            document.querySelectorAll('.penilaian-tab-panel').forEach(function (panel) {
                panel.classList.add('hidden');
            });
            document.querySelectorAll('.penilaian-tab-btn').forEach(function (btn) {
                btn.classList.remove('bg-white', 'border-blue-500', 'text-blue-700');
                btn.classList.add('bg-gray-50', 'border-transparent', 'text-gray-500');
            });
            const target = document.getElementById(targetId);
            if (target) target.classList.remove('hidden');
            if (btnEl) {
                btnEl.classList.remove('bg-gray-50', 'border-transparent', 'text-gray-500');
                btnEl.classList.add('bg-white', 'border-blue-500', 'text-blue-700');
            }

            const hiddenInput = document.getElementById('active-tab-input');
            if (hiddenInput) {
                hiddenInput.value = targetId;
            }
        }

        // Buka/tutup modal Portofolio per mahasiswa
        function openPortofolio(nim) {
            const modal = document.getElementById('portofolio-modal-' + nim);
            if (modal) modal.classList.remove('hidden');
        }
        function closePortofolio(nim) {
            const modal = document.getElementById('portofolio-modal-' + nim);
            if (modal) modal.classList.add('hidden');
        }



        function toggleRpsMatrix() {
            const container = document.getElementById('rps-matrix-container');
            const text = document.getElementById('toggle-matrix-text');
            const icon = document.getElementById('toggle-matrix-icon');
            if (container.classList.contains('hidden')) {
                container.classList.remove('hidden');
                text.innerText = 'Sembunyikan';
                icon.classList.remove('fa-chevron-down');
                icon.classList.add('fa-chevron-up');
            } else {
                container.classList.add('hidden');
                text.innerText = 'Tampilkan';
                icon.classList.remove('fa-chevron-up');
                icon.classList.add('fa-chevron-down');
            }
        }

        // AJAX Save
        document.getElementById('penilaian-form').addEventListener('submit', function(e) {
            e.preventDefault();

            const saveBtn = document.getElementById('save-button');
            const originalHTML = saveBtn.innerHTML;

            saveBtn.disabled = true;
            saveBtn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Menyimpan...`;

            // dikirim sbg application/x-www-form-urlencoded (bukan multipart/form-data
            // bawaan FormData), krn route ini cuma pakai body-parser urlencoded standar
            // (ga ada middleware multer terpasang). kalau dikirim sbg FormData mentah,
            // req.body di server bakal KOSONG - nilai & komentar keliatan "tersimpan"
            // di UI (alert sukses tetap muncul krn fetch-nya sendiri berhasil), padahal
            // sebenarnya ga ada satupun field yg nyampe ke server.
            const bodyParams = new URLSearchParams(new FormData(this));

            fetch(this.action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: bodyParams.toString()
            })
            .then((res) => {
                if (!res.ok) {
                    throw new Error('Server merespons dengan status ' + res.status);
                }
                // Success message
                const successDiv = document.createElement('div');
                successDiv.className = 'mb-4 p-3 rounded bg-green-100 text-green-800 border border-green-300 flex items-center';
                successDiv.innerHTML = `<i class="fas fa-check-circle mr-2"></i> Nilai berhasil disimpan.`;
                
                const firstCard = document.querySelector('.card.mb-6');
                if (firstCard) firstCard.parentNode.insertBefore(successDiv, firstCard.nextSibling);

                setTimeout(() => successDiv.remove(), 4000);

                // Soft reload to show updated values
                setTimeout(() => window.location.reload(), 800);
            })
            .catch(err => {
                console.error(err);
                alert('Gagal menyimpan nilai. Silakan coba lagi.');
            })
            .finally(() => {
                saveBtn.disabled = false;
                saveBtn.innerHTML = originalHTML;
            });
        });

        // Floating Buttons
        function jumpToBottom() {
            window.scrollTo({ top: document.body.scrollHeight, behavior: 'smooth' });
        }

        function scrollToTop() {
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        // Show Return to Top button when scrolled down
        window.addEventListener('scroll', () => {
            const btn = document.getElementById('return-to-top-btn');
            if (btn) btn.classList.toggle('hidden', window.scrollY < 400);
        });

        //Download Portofolio PDF
       function downloadPortofolioPDF(nim, namaMahasiswa) {
        const modal = document.getElementById('portofolio-modal-' + nim);
        if (!modal) return;

        const content = modal.querySelector('.p-6');
        if (!content) return;

        const element = document.createElement('div');
        element.style.padding = '0';
        element.style.margin = '0';
        element.style.fontFamily = 'Arial, sans-serif';
        element.style.fontSize = '11px';
        element.style.lineHeight = '1.3';

        element.innerHTML = `
            <div style="border-bottom: 1.5px solid #1e40af; padding-bottom: 6px; margin-bottom: 10px;">
            <h2 style="margin: 0; color: #1e40af; font-size: 15px;">PORTOFOLIO MAHASISWA</h2>
            <p style="margin: 3px 0 0; font-size: 12px;">
                <strong>${namaMahasiswa}</strong> | NIM: ${nim}
            </p>
            <p style="margin: 2px 0 0; font-size: 10px; color: #555;">
                Kelas: <%= kelasLabel %> | Mata Kuliah: <%= rpsItem.nama_mk %> (<%= rpsItem.kode_mk %>)
            </p>
            </div>

            ${content.innerHTML}
        `;

        const opt = {
            margin:       [5, 8, 5, 8],   // top, left, bottom, right (sangat kecil)
            filename:     `Portofolio_${nim}_${namaMahasiswa.replace(/\s+/g, '_')}.pdf`,
            image:        { type: 'jpeg', quality: 0.98 },
            html2canvas:  { 
            scale: 2, 
            useCORS: true,
            logging: false,
            scrollY: 0
            },
            jsPDF:        { unit: 'mm', format: 'a4', orientation: 'portrait' }
        };

        const btn = event.currentTarget;
        const originalHTML = btn.innerHTML;
        btn.innerHTML = `<i class="fas fa-spinner fa-spin"></i> Membuat PDF...`;
        btn.disabled = true;

        html2pdf().set(opt).from(element).save().then(() => {
            btn.innerHTML = originalHTML;
            btn.disabled = false;
        }).catch(err => {
            console.error(err);
            alert('Gagal membuat PDF. Silakan coba lagi.');
            btn.innerHTML = originalHTML;
            btn.disabled = false;
        });
        }
    </script>

<!-- Floating Buttons - Side by Side -->
<div class="fixed bottom-8 right-8 flex gap-3 z-50">
    <!-- Jump to Bottom -->
    <button onclick="jumpToBottom()" 
            class="bg-blue-600 hover:bg-blue-700 text-white w-12 h-12 rounded-full shadow-lg flex items-center justify-center transition-all">
        <i class="fas fa-arrow-down text-xl"></i>
    </button>

    <!-- Return to Top -->
    <button onclick="scrollToTop()" 
            id="return-to-top-btn"
            class="bg-gray-600 hover:bg-gray-700 text-white w-12 h-12 rounded-full shadow-lg flex items-center justify-center transition-all hidden">
        <i class="fas fa-arrow-up text-xl"></i>
    </button>
</div>

