<%- include('partials/header') %>

<div class="container-custom">
  <div class="card">
    <h2 class="card-title">Input Data Mahasiswa</h2>
    <p class="text-gray-600 mb-4">Form ini menambahkan dan mengelola data mahasiswa di database.</p>

    <% if (typeof req !== 'undefined' && req.query && req.query.saved) { %>
      <div class="p-3 bg-green-100 text-green-800 rounded mb-4">Data mahasiswa berhasil disimpan.</div>
    <% } %>

    <% if (typeof req !== 'undefined' && req.query && req.query.updated) { %>
      <div class="p-3 bg-green-100 text-green-800 rounded mb-4">Data mahasiswa berhasil diperbarui.</div>
    <% } %>

    <% if (typeof req !== 'undefined' && req.query && req.query.deleted) { %>
      <div class="p-3 bg-green-100 text-green-800 rounded mb-4">Data mahasiswa berhasil dihapus.</div>
    <% } %>

    <% if (typeof req !== 'undefined' && req.query && req.query.error === 'missing') { %>
      <div class="p-3 bg-red-100 text-red-800 rounded mb-4">Semua field wajib diisi.</div>
    <% } %>

    <% if (typeof req !== 'undefined' && req.query && req.query.error === 'duplicate') { %>
      <div class="p-3 bg-yellow-100 text-yellow-800 rounded mb-4">ID atau NIM sudah ada.</div>
    <% } %>

    <% if (typeof req !== 'undefined' && req.query && req.query.error === 'not-found') { %>
      <div class="p-3 bg-red-100 text-red-800 rounded mb-4">Data mahasiswa tidak ditemukan.</div>
    <% } %>

    <% if (typeof req !== 'undefined' && req.query && req.query.imported) { %>
      <div class="p-3 bg-green-100 text-green-800 rounded mb-4">
        Import selesai: <%= req.query.added || 0 %> mahasiswa ditambahkan.
        <% if (parseInt(req.query.dup, 10) > 0) { %> <%= req.query.dup %> dilewati (NIM sudah ada).<% } %>
        <% if (parseInt(req.query.inactive, 10) > 0) { %> <%= req.query.inactive %> dilewati (status tidak Aktif).<% } %>
        <% if (parseInt(req.query.invalid, 10) > 0) { %> <%= req.query.invalid %> dilewati (data tidak lengkap).<% } %>
      </div>
    <% } %>

    <% if (typeof req !== 'undefined' && req.query && req.query.error === 'multer-missing') { %>
      <div class="p-3 bg-red-100 text-red-800 rounded mb-4">Fitur import Excel belum aktif karena package multer belum terinstall. Jalankan npm install, lalu restart server.</div>
    <% } %>

    <% if (typeof req !== 'undefined' && req.query && req.query.error === 'xlsx-missing') { %>
      <div class="p-3 bg-red-100 text-red-800 rounded mb-4">Fitur import Excel belum aktif karena package xlsx belum terinstall. Jalankan npm install xlsx, lalu restart server.</div>
    <% } %>

    <% if (typeof req !== 'undefined' && req.query && (req.query.error === 'upload' || req.query.error === 'parse' || req.query.error === 'no-file')) { %>
      <div class="p-3 bg-red-100 text-red-800 rounded mb-4">
        <%= req.query.message || 'Gagal memproses file Excel. Pastikan file yg dipilih sudah benar.' %>
      </div>
    <% } %>

    <form action="/admin/mahasiswa" method="POST" class="mt-4 space-y-4">
      <div class="grid md:grid-cols-2 gap-4">
        <div>
          <label class="label">NIM</label>
          <input class="input" name="nim" placeholder="20250104" required>
        </div>
        <div>
          <label class="label">Nama Mahasiswa</label>
          <input class="input" name="nama" placeholder="Nama Lengkap" required>
        </div>
        <div>
          <label class="label">Angkatan</label>
          <input class="input" type="number" name="angkatan" placeholder="2025" min="2000" max="2099" required>
        </div>
        <div>
          <label class="label">Kelas</label>
          <select class="input" name="huruf" required>
            <option value="">-- Pilih Kelas --</option>
            <% const hurufKelasChoicesAdd = (typeof hurufKelasChoices !== 'undefined' && Array.isArray(hurufKelasChoices)) ? hurufKelasChoices : ['A', 'B', 'C', 'D']; %>
            <% hurufKelasChoicesAdd.forEach(function(h) { %>
              <option value="<%= h %>"><%= h %></option>
            <% }); %>
          </select>
        </div>
      </div>

      <div class="flex justify-end">
        <button class="btn-primary" type="submit">Simpan Mahasiswa</button>
      </div>
    </form>

    <hr class="my-6">

    <!-- Import dari Excel -->
    <h3 class="font-semibold mb-2">Import dari Excel</h3>
    <p class="text-gray-600 text-sm mb-3">
      Upload file Excel (.xlsx/.xls) berisi kolom <strong>NIM</strong>, <strong>Nama</strong>,
      <strong>Tahun Angkatan</strong>, dan <strong>Huruf Kelas</strong> (misal hasil export dari SIAKAD).
      Mahasiswa dgn NIM yg sudah ada atau status bukan "Aktif" akan otomatis dilewati.
    </p>
    <form action="/admin/mahasiswa/import" method="POST" enctype="multipart/form-data" class="flex flex-wrap items-center gap-3">
      <input class="input file-input-styled" type="file" name="excelFile" accept=".xlsx,.xls" required>
      <button class="btn-secondary" type="submit">Import</button>
    </form>

    <hr class="my-6">

    <!-- Kelola Tingkat Kelas -->
    <details class="mb-2">
      <summary class="font-semibold cursor-pointer select-none py-1">Kelola Tingkat Kelas</summary>
      
      <p class="text-gray-600 text-sm mb-3 mt-2">
        Pilih Angkatan, lalu tentukan Tingkat Saat Ini (1–4). Perubahan akan diterapkan ke semua kelas pada angkatan tersebut.
      </p>

      <% if (typeof req !== 'undefined' && req.query && req.query['tingkat-updated']) { %>
        <div class="p-3 bg-green-100 text-green-800 rounded mb-4">Tingkat kelas berhasil diperbarui.</div>
      <% } %>
      <% if (typeof req !== 'undefined' && req.query && req.query.error === 'tingkat-invalid') { %>
        <div class="p-3 bg-red-100 text-red-800 rounded mb-4">Tingkat harus angka 1-4.</div>
      <% } %>
      <% if (typeof req !== 'undefined' && req.query && req.query.error === 'angkatan-not-found') { %>
        <div class="p-3 bg-red-100 text-red-800 rounded mb-4">Angkatan tidak ditemukan.</div>
      <% } %>

      <form action="/admin/kelas/update-tingkat-by-angkatan" method="POST" 
        class="grid grid-cols-1 sm:grid-cols-[1fr_1fr_auto] gap-4 items-end mb-4">
        
        <div>
          <label class="label">Angkatan</label>
          <select class="input w-full" name="angkatan" required>
            <option value="">-- Pilih Angkatan --</option>
            <% const angkatanList = (typeof tingkatOptions !== 'undefined' && Array.isArray(tingkatOptions)) ? tingkatOptions : []; %>
            <% angkatanList.forEach(function(t) { %>
              <option value="<%= t %>">Angkatan <%= t %></option>
            <% }); %>
          </select>
        </div>

        <div>
          <label class="label">Tingkat Saat Ini</label>
          <select class="input w-full" name="tingkatSaatIni" required>
            <option value="">-- Pilih Tingkat --</option>
            <% [1, 2, 3, 4].forEach(function(t) { %>
              <option value="<%= t %>"><%= t %></option>
            <% }); %>
          </select>
        </div>

        <div>
          <button type="submit" class="btn-secondary w-full sm:w-auto px-6 py-[0.65rem]">
            Simpan Tingkat
          </button>
        </div>
      </form>
    </details>

    <hr class="my-6">
    
    <!-- Form daftar Mahasiswa-->
    <h3 class="font-semibold mb-3">Daftar Mahasiswa</h3>

    <!-- Filter berdasarkan Angkatan, Kelas, Nama & NIM -->
    <div class="bg-gray-50 p-3 rounded-lg border border-gray-200 mb-6">
      <form action="/admin/mahasiswa" method="GET" class="flex flex-wrap items-center gap-4 text-sm">
        
        <div class="flex items-center gap-2">
          <label class="font-semibold text-gray-700 whitespace-nowrap">Angkatan:</label>
          <select class="border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:border-blue-500 h-9 text-sm" name="tingkat" onchange="this.form.submit()">
            <option value="">Semua Angkatan</option>
            <% const tingkatOptionsList = (typeof tingkatOptions !== 'undefined' && Array.isArray(tingkatOptions)) ? tingkatOptions : []; %>
            <% tingkatOptionsList.forEach(function(t) { %>
              <option value="<%= t %>" <%= (typeof tingkatFilter !== 'undefined' && tingkatFilter === t) ? 'selected' : '' %>>Angkatan <%= t %></option>
            <% }); %>
          </select>
        </div>

        <div class="flex items-center gap-2">
          <label class="font-semibold text-gray-700 whitespace-nowrap">Kelas:</label>
          <select class="border border-gray-300 rounded px-2 py-1 bg-white focus:outline-none focus:border-blue-500 h-9 text-sm" name="huruf" onchange="this.form.submit()">
            <option value="">Semua Kelas</option>
            <% const hurufOptionsList = (typeof hurufOptions !== 'undefined' && Array.isArray(hurufOptions)) ? hurufOptions : []; %>
            <% hurufOptionsList.forEach(function(h) { %>
              <option value="<%= h %>" <%= (typeof hurufFilter !== 'undefined' && hurufFilter === h) ? 'selected' : '' %>>Kelas <%= h %></option>
            <% }); %>
          </select>
        </div>

        <div class="flex items-center gap-2">
          <label class="font-semibold text-gray-700 whitespace-nowrap">Nama:</label>
          <input class="border border-gray-300 rounded px-3 py-1 focus:outline-none focus:border-blue-500 h-9 text-sm w-40" type="text" name="nama" placeholder="Cari nama..." value="<%= (typeof namaFilter !== 'undefined' && namaFilter) ? namaFilter : '' %>">
        </div>

        <div class="flex items-center gap-2">
          <label class="font-semibold text-gray-700 whitespace-nowrap">NIM:</label>
          <input class="border border-gray-300 rounded px-3 py-1 focus:outline-none focus:border-blue-500 h-9 text-sm w-32" type="text" name="nim" placeholder="Cari NIM..." value="<%= (typeof nimFilter !== 'undefined' && nimFilter) ? nimFilter : '' %>">
        </div>

        <div class="flex gap-2">
          <button class="bg-blue-600 hover:bg-blue-700 text-white font-semibold px-4 py-1.5 rounded text-xs transition duration-150 ease-in-out h-9" type="submit">
            <i class="fas fa-search mr-1"></i>Cari
          </button>
          <% if ((typeof tingkatFilter !== 'undefined' && tingkatFilter) || (typeof hurufFilter !== 'undefined' && hurufFilter) || (typeof namaFilter !== 'undefined' && namaFilter) || (typeof nimFilter !== 'undefined' && nimFilter)) { %>
            <a href="/admin/mahasiswa" class="bg-gray-200 hover:bg-gray-300 text-gray-700 font-semibold px-3 py-1.5 rounded text-xs transition duration-150 ease-in-out h-9 flex items-center justify-center">
              Clear
            </a>
          <% } %>
        </div>
      </form>
    </div>

    <!-- dipakai supaya link pagination di bawah tetap bawa filter angkatan, kelas, nama & nim yg aktif -->
    <% const filterQS =
      ((typeof tingkatFilter !== 'undefined' && tingkatFilter) ? '&tingkat=' + tingkatFilter : '') +
      ((typeof hurufFilter !== 'undefined' && hurufFilter) ? '&huruf=' + hurufFilter : '') +
      ((typeof namaFilter !== 'undefined' && namaFilter) ? '&nama=' + encodeURIComponent(namaFilter) : '') +
      ((typeof nimFilter !== 'undefined' && nimFilter) ? '&nim=' + encodeURIComponent(nimFilter) : '');
    %>

    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
      <!--Pagination 20 per page-->
      <% const perPage = (typeof pageSize !== 'undefined' && pageSize) ? pageSize : 20; %>
      <% const pageNumber = Math.max(1, parseInt(currentPage || 1, 10)); %>
      <!--Determine the first and last visible item for the current page-->
      <% const startItem = (totalItems || 0) > 0 ? ((pageNumber - 1) * perPage) + 1 : 0; %>
      <% const endItem = (totalItems || 0) > 0 ? Math.min(pageNumber * perPage, totalItems || 0) : 0; %>
      <!--Show the actual number of rows on this page, including the last page with fewer items-->
      <% const visibleCount = (totalItems || 0) > 0 ? Math.max(0, endItem - startItem + 1) : 0; %>
      <div class="flex flex-wrap items-center justify-between gap-3 mb-4 text-sm text-gray-600">
        <div>Menampilkan <%= visibleCount %> data (dari <%= totalItems || 0 %>)</div>
        <div class="flex flex-wrap items-center gap-2">
          <% if ((currentPage || 1) > 1) { %>
            <a href="/admin/mahasiswa?page=<%= (currentPage || 1) - 1 %><%= filterQS %>" class="px-3 py-1 border rounded hover:bg-gray-100">Sebelumnya</a>
          <% } %>

          <!-- Batasi tombol nomor halaman maksimal 5, digeser mengikuti halaman aktif -->
          <% const maxPageButtons = 5; %>
          <% let windowStart = Math.max(1, pageNumber - Math.floor(maxPageButtons / 2)); %>
          <% let windowEnd = Math.min(totalPages, windowStart + maxPageButtons - 1); %>
          <% windowStart = Math.max(1, windowEnd - maxPageButtons + 1); %>

          <% if (windowStart > 1) { %>
            <a href="/admin/mahasiswa?page=1<%= filterQS %>" class="px-3 py-1 border rounded hover:bg-gray-100">1</a>
            <% if (windowStart > 2) { %><span class="px-1 text-gray-400">...</span><% } %>
          <% } %>

          <% for (let i = windowStart; i <= windowEnd; i++) { %>
            <a href="/admin/mahasiswa?page=<%= i %><%= filterQS %>" class="px-3 py-1 border rounded <%= i === (currentPage || 1) ? 'bg-blue-600 text-white border-blue-600' : 'hover:bg-gray-100' %>"><%= i %></a>
          <% } %>

          <% if (windowEnd < totalPages) { %>
            <% if (windowEnd < totalPages - 1) { %><span class="px-1 text-gray-400">...</span><% } %>
            <a href="/admin/mahasiswa?page=<%= totalPages %><%= filterQS %>" class="px-3 py-1 border rounded hover:bg-gray-100"><%= totalPages %></a>
          <% } %>

          <% if ((currentPage || 1) < totalPages) { %>
            <a href="/admin/mahasiswa?page=<%= (currentPage || 1) + 1 %><%= filterQS %>" class="px-3 py-1 border rounded hover:bg-gray-100">Berikutnya</a>
          <% } %>

          <!-- Jump to Page-->
          <form action="/admin/mahasiswa" method="GET" class="flex items-center gap-2 ml-1">
            <input type="number" name="page" min="1" max="<%= totalPages %>" placeholder="Halaman" class="w-24 px-2 py-1 border rounded text-sm" required>
            <% if (typeof tingkatFilter !== 'undefined' && tingkatFilter) { %>
              <input type="hidden" name="tingkat" value="<%= tingkatFilter %>">
            <% } %>
            <% if (typeof hurufFilter !== 'undefined' && hurufFilter) { %>
              <input type="hidden" name="huruf" value="<%= hurufFilter %>">
            <% } %>
            <% if (typeof namaFilter !== 'undefined' && namaFilter) { %>
              <input type="hidden" name="nama" value="<%= namaFilter %>">
            <% } %>
            <% if (typeof nimFilter !== 'undefined' && nimFilter) { %>
              <input type="hidden" name="nim" value="<%= nimFilter %>">
            <% } %>
            <button type="submit" class="px-3 py-1 border rounded bg-gray-100 hover:bg-gray-200">Go</button>
          </form>
        </div>
      </div>
    <% } %>

    <div class="overflow-x-auto">
      <table class="min-w-full bg-white rounded-lg overflow-hidden">
        <thead>
          <tr class="bg-gray-100 text-left">
            <th class="px-4 py-2">NIM</th>
            <th class="px-4 py-2">Nama</th>
            <th class="px-4 py-2">Angkatan</th>
            <th class="px-4 py-2">Kelas</th>
            <th class="px-4 py-2">Manajemen</th>
          </tr>
        </thead>
        <tbody>
          <% if (mahasiswa.length === 0) { %>
            <tr>
              <td colspan="6" class="px-4 py-4 text-center text-gray-500">Belum ada data mahasiswa.</td>
            </tr>
          <% } else { %>
            <% mahasiswa.forEach(function(item) { %>
              <% const kelasMatch = String(item.kelasId || '').match(/^(\d+)([A-Za-z]+)$/); %>
              <% const kelasRecord = (typeof kelas !== 'undefined' && Array.isArray(kelas)) ? kelas.find(function(k) { return k.id === item.kelasId; }) : null; %>
              <% const kelasFullLabel = (kelasRecord && Number.isInteger(kelasRecord.tingkatSaatIni) && kelasMatch)
                    ? `${kelasRecord.tingkatSaatIni}${kelasMatch[2]}`
                    : (item.kelasId || '-'); %>
              <tr class="border-t">
                <td class="px-4 py-2"><%= item.nim %></td>
                <td class="px-4 py-2"><%= item.nama %></td>
                <td class="px-4 py-2"><%= kelasMatch ? kelasMatch[1] : item.kelasId %></td>
                <td class="px-4 py-2"><%= kelasFullLabel %></td>
                <td class="px-4 py-2">
                  <div class="flex flex-wrap gap-2">
                    <button class="btn-secondary text-xs" type="button" onclick="toggleEdit('<%= item.id %>')">Edit</button>
                    <form action="/admin/mahasiswa/delete/<%= item.id %>" method="POST" class="inline" onsubmit="return confirm('Hapus data mahasiswa ini?')">
                      <button class="btn-danger text-xs" type="submit">Delete</button>
                    </form>
                  </div>
                  <div id="edit-form-<%= item.id %>" class="mt-3" style="display:none;">
                    <form action="/admin/mahasiswa/update/<%= item.id %>" method="POST" class="space-y-3">
                      <div class="grid md:grid-cols-2 gap-3">
                        <div>
                          <label class="label">NIM</label>
                          <input class="input" name="nim" value="<%= item.nim %>" required>
                        </div>
                        <div>
                          <label class="label">Nama Mahasiswa</label>
                          <input class="input" name="nama" value="<%= item.nama %>" required>
                        </div>
                        <div>
                          <label class="label">Angkatan</label>
                          <input class="input" type="number" name="angkatan" 
                                value="<%= kelasMatch ? kelasMatch[1] : '' %>" 
                                min="2000" max="2099" required>
                        </div>
                        <div>
                          <label class="label">Kelas</label>
                          <select class="input" name="huruf" required>
                            <option value="">-- Pilih Kelas --</option>
                            <% 
                              const hurufKelasChoicesEdit = (typeof hurufKelasChoices !== 'undefined' && Array.isArray(hurufKelasChoices)) 
                                ? hurufKelasChoices 
                                : ['A', 'B', 'C', 'D']; 
                              
                              // Cari tingkatSaatIni dari kelas yang sedang diedit (jika ada)
                              const currentKelasRecord = (typeof kelas !== 'undefined' && Array.isArray(kelas)) 
                                ? kelas.find(k => k.id === item.kelasId) 
                                : null;
                              const currentTingkat = currentKelasRecord && Number.isInteger(currentKelasRecord.tingkatSaatIni) 
                                ? currentKelasRecord.tingkatSaatIni 
                                : null;
                            %>
                            <% hurufKelasChoicesEdit.forEach(function(h) { %>
                              <% 
                                // Tampilkan dengan tingkat jika memungkinkan
                                const displayLabel = currentTingkat ? `${currentTingkat}${h}` : h;
                              %>
                              <option value="<%= h %>" <%= (kelasMatch && kelasMatch[2] === h) ? 'selected' : '' %>>
                                <%= displayLabel %>
                              </option>
                            <% }); %>
                          </select>
                        </div>
                      </div>
                      <div class="flex justify-end">
                        <button class="btn-primary text-xs" type="submit">Simpan Perubahan</button>
                      </div>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } %>
        </tbody>
      </table>
    </div>

    <% if (typeof totalPages !== 'undefined' && totalPages > 1) { %>
      <!--Same pagination summary for the bottom pager so the page count stays consistent-->
      <% const perPageBottom = (typeof pageSize !== 'undefined' && pageSize) ? pageSize : 20; %>
      <% const pageNumberBottom = Math.max(1, parseInt(currentPage || 1, 10)); %>
      <% const startItemBottom = (totalItems || 0) > 0 ? ((pageNumberBottom - 1) * perPageBottom) + 1 : 0; %>
      <% const endItemBottom = (totalItems || 0) > 0 ? Math.min(pageNumberBottom * perPageBottom, totalItems || 0) : 0; %>
      <% const visibleCountBottom = (totalItems || 0) > 0 ? Math.max(0, endItemBottom - startItemBottom + 1) : 0; %>
      <div class="flex flex-wrap items-center justify-between gap-3 mt-4 text-sm text-gray-600">
        <div>Menampilkan <%= visibleCountBottom %> data (dari <%= totalItems || 0 %>)</div>
        <div class="flex flex-wrap items-center gap-2">
          <% if ((currentPage || 1) > 1) { %>
            <a href="/admin/mahasiswa?page=<%= (currentPage || 1) - 1 %><%= filterQS %>" class="px-3 py-1 border rounded hover:bg-gray-100">Sebelumnya</a>
          <% } %>

          <!-- Batasi tombol nomor halaman maksimal 5, digeser mengikuti halaman aktif -->
          <% const maxPageButtonsBottom = 5; %>
          <% let windowStartBottom = Math.max(1, pageNumberBottom - Math.floor(maxPageButtonsBottom / 2)); %>
          <% let windowEndBottom = Math.min(totalPages, windowStartBottom + maxPageButtonsBottom - 1); %>
          <% windowStartBottom = Math.max(1, windowEndBottom - maxPageButtonsBottom + 1); %>

          <% if (windowStartBottom > 1) { %>
            <a href="/admin/mahasiswa?page=1<%= filterQS %>" class="px-3 py-1 border rounded hover:bg-gray-100">1</a>
            <% if (windowStartBottom > 2) { %><span class="px-1 text-gray-400">...</span><% } %>
          <% } %>

          <% for (let i = windowStartBottom; i <= windowEndBottom; i++) { %>
            <a href="/admin/mahasiswa?page=<%= i %><%= filterQS %>" class="px-3 py-1 border rounded <%= i === (currentPage || 1) ? 'bg-blue-600 text-white border-blue-600' : 'hover:bg-gray-100' %>"><%= i %></a>
          <% } %>

          <% if (windowEndBottom < totalPages) { %>
            <% if (windowEndBottom < totalPages - 1) { %><span class="px-1 text-gray-400">...</span><% } %>
            <a href="/admin/mahasiswa?page=<%= totalPages %><%= filterQS %>" class="px-3 py-1 border rounded hover:bg-gray-100"><%= totalPages %></a>
          <% } %>

          <% if ((currentPage || 1) < totalPages) { %>
            <a href="/admin/mahasiswa?page=<%= (currentPage || 1) + 1 %><%= filterQS %>" class="px-3 py-1 border rounded hover:bg-gray-100">Berikutnya</a>
          <% } %>

          <form action="/admin/mahasiswa" method="GET" class="flex items-center gap-2 ml-1">
            <input type="number" name="page" min="1" max="<%= totalPages %>" placeholder="Halaman" class="w-24 px-2 py-1 border rounded text-sm" required>
            <% if (typeof tingkatFilter !== 'undefined' && tingkatFilter) { %>
              <input type="hidden" name="tingkat" value="<%= tingkatFilter %>">
            <% } %>
            <% if (typeof hurufFilter !== 'undefined' && hurufFilter) { %>
              <input type="hidden" name="huruf" value="<%= hurufFilter %>">
            <% } %>
            <% if (typeof namaFilter !== 'undefined' && namaFilter) { %>
              <input type="hidden" name="nama" value="<%= namaFilter %>">
            <% } %>
            <% if (typeof nimFilter !== 'undefined' && nimFilter) { %>
              <input type="hidden" name="nim" value="<%= nimFilter %>">
            <% } %>
            <button type="submit" class="px-3 py-1 border rounded bg-gray-100 hover:bg-gray-200">Go</button>
          </form>
        </div>
      </div>
    <% } %>
  </div>
</div>

<%- include('partials/footer') %>

<script>
function toggleEdit(id) {
  const area = document.getElementById('edit-form-' + id);
  if (!area) return;
  area.style.display = (area.style.display === 'block') ? 'none' : 'block';
}
</script>
