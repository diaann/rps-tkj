<%- include('partials/header') %>

<style>
    .revision-page {
    }

    .revision-title {
        font-size: 2rem;
        line-height: 1.15;
        font-weight: 800;
        color: #111827;
    }

    .revision-toolbar {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
        align-items: center;
        justify-content: space-between;
    }

    .revision-list {
        list-style: disc;
        padding-left: 1.5rem;
        margin-top: 1rem;
    }

    .revision-list li {
        padding: 0.45rem 0;
        border-bottom: 1px solid #f3f4f6;
    }

    .revision-link {
        color: #2563eb;
        font-weight: 600;
        text-decoration: none;
    }

    .revision-link:hover {
        text-decoration: underline;
    }

    .inline-revert-form {
        display: inline;
    }

    .inline-revert-button {
        color: #2563eb;
        font-weight: 600;
        background: transparent;
        border: 0;
        padding: 0;
        cursor: pointer;
        font: inherit;
    }

    .inline-revert-button:hover {
        text-decoration: underline;
    }

    .revision-meta {
        color: #4b5563;
    }

    .revision-name {
        color: #111827;
        font-weight: 800;
    }

    .revision-delta-positive {
        color: #059669;
        font-weight: 700;
    }

    .revision-delta-neutral {
        color: #6b7280;
        font-weight: 700;
    }

    .revision-delta-revert {
        color: #dc2626;
        font-weight: 700;
    }

    .current-badge {
        display: inline-flex;
        align-items: center;
        gap: 0.25rem;
        background: #dcfce7;
        color: #166534;
        border-radius: 999px;
        padding: 0.1rem 0.55rem;
        font-size: 0.75rem;
        font-weight: 700;
    }

    .action-badge {
        display: inline-flex;
        align-items: center;
        border-radius: 999px;
        padding: 0.1rem 0.5rem;
        font-size: 0.72rem;
        font-weight: 700;
        background: #eff6ff;
        color: #1d4ed8;
    }

    .action-badge.revert {
        background: #fef2f2;
        color: #b91c1c;
    }

    .action-badge.initial,
    .action-badge.create,
    .action-badge.submit_validasi {
        background: #f3f4f6;
        color: #374151;
    }

    .action-badge.acc {
        background: #dcfce7;
        color: #166534;
    }

    .status-banner {
        border-radius: 0.75rem;
        padding: 0.75rem 1rem;
        margin-bottom: 1.25rem;
        font-size: 0.9rem;
        font-weight: 600;
    }

    .status-banner.status-draft { background: #f3f4f6; color: #374151; }
    .status-banner.status-diajukan { background: #fef9c3; color: #854d0e; }
    .status-banner.status-disetujui { background: #dcfce7; color: #166534; }
    .status-banner.status-ditolak { background: #fee2e2; color: #b91c1c; }

    .revision-summary-card {
        border: 1px solid #e5e7eb;
        border-radius: 0.75rem;
        padding: 1rem;
        background: #f9fafb;
    }
</style>

<%
    const rpsStatus = rps.status || 'draft';
    const rpsLocked = rpsStatus === 'diajukan' || rpsStatus === 'disetujui';
    const statusLabels = { draft: 'Draft', diajukan: 'Menunggu Persetujuan KoPS', disetujui: 'Disetujui (Final)', ditolak: 'Ditolak KoPS' };
%>

<div class="container-custom">
    <div class="card revision-page">
        <div class="revision-toolbar mb-4">
            <div>
                <h1 class="revision-title">
                    <%= rps.nama_mk || 'Dokumen RPS' %>
                    <span class="text-xl font-bold text-gray-700">(Riwayat perubahan)</span>
                </h1>
                <p class="text-gray-600 mt-2">
                    Kode MK: <strong><%= rps.kode_mk || '-' %></strong>
                    &middot; Semester <strong><%= rps.semester || '-' %></strong>
                    &middot; Tahun Akademik <strong><%= rps.tahun_akademik || '-' %></strong>
                </p>
            </div>

            <div class="flex flex-wrap gap-2">
                <a href="/history/view/<%= rps.id %>" class="btn-primary text-sm flex items-center gap-2 px-4 py-2">
                    <i class="fas fa-eye"></i>
                    Lihat Versi Saat Ini
                </a>
                <% if (!rpsLocked) { %>
                    <a href="/edit-rps/<%= rps.id %>" class="btn-secondary text-sm flex items-center gap-2 px-4 py-2">
                        <i class="fas fa-edit"></i>
                        Edit
                    </a>
                <% } %>
                <a href="<%= user.role === 'admin' ? '/admin/rps' : '/history' %>" class="btn-secondary text-sm flex items-center gap-2 px-4 py-2">
                    <i class="fas fa-arrow-left"></i>
                    Kembali
                </a>
            </div>
        </div>

        <div class="status-banner status-<%= rpsStatus %>">
            <div>Status: <%= statusLabels[rpsStatus] || rpsStatus %></div>
            <% if (rpsStatus === 'ditolak' && rps.rejection_note) { %>
                <div class="mt-1 font-normal">Catatan KoPS: <%= rps.rejection_note %></div>
            <% } %>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
            <div class="revision-summary-card">
                <p class="text-sm text-gray-500">Total Revisi</p>
                <p class="text-2xl font-extrabold text-gray-900"><%= revisions.length %></p>
            </div>
            <div class="revision-summary-card">
                <p class="text-sm text-gray-500">Versi Terbaru</p>
                <p class="text-2xl font-extrabold text-gray-900">
                    <% if (revisions.length) { %>
                        <%= revisions[revisions.length - 1].revision_name %>
                    <% } else { %>
                        -
                    <% } %>
                </p>
            </div>
            <div class="revision-summary-card">
                <p class="text-sm text-gray-500">Terakhir Diubah Oleh</p>
                <p class="text-lg font-bold text-gray-900 truncate">
                    <% if (revisions.length) { %>
                        <%= revisions[revisions.length - 1].editorName || revisions[revisions.length - 1].edited_by_username || 'System' %>
                    <% } else { %>
                        -
                    <% } %>
                </p>
            </div>
        </div>

        <p class="text-sm text-gray-500 mb-5">
            Lihat riwayat perubahan RPS atau pulihkan versi sebelumnya.
        </p>

        <% if (revisions.length > 0) { %>
            <% const latestRevisionId = revisions.length ? revisions[revisions.length - 1].id : null; %>
            <!-- daftar semua revisi, terbaru di atas -->
            <ul class="revision-list">
                <% revisions.slice().reverse().forEach(function(rev) { %>
                    <% const isLatest = rev.id === latestRevisionId; %>
                    <%
                        const actionClass = rev.action === 'revert' || rev.action === 'tolak_kaprodi' ? 'revert'
                            : rev.action === 'acc_kaprodi' ? 'acc'
                            : (rev.action === 'initial' || rev.action === 'create' || rev.action === 'submit_validasi') ? rev.action
                            : 'edit';
                        const actionLabels = {
                            edit: 'edit',
                            revert: 'revert',
                            initial: 'create',
                            create: 'create',
                            upload_pdf: 'upload',
                            upload_docx: 'upload',
                            duplicate: 'duplicate',
                            duplicated: 'duplicate',
                            copy: 'duplicate',
                            clone: 'duplicate',
                            submit_validasi: 'ajukan validasi',
                            acc_kaprodi: 'disetujui KoPS',
                            tolak_kaprodi: 'ditolak KoPS'
                        };
                        const actionLabel = actionLabels[rev.action] || 'edit';
                    %>
                    <li>
                        <span class="revision-meta">
                            <%= new Date(rev.edited_at).toLocaleString('id-ID', {
                                year: 'numeric',
                                month: '2-digit',
                                day: '2-digit',
                                hour: '2-digit',
                                minute: '2-digit',
                                second: '2-digit'
                            }) %>
                        </span>
                        <span class="text-gray-500">(</span>
                        <a class="revision-link" href="/history/rps/<%= rps.id %>/revision/<%= rev.id %>">Lihat</a>
                        <% if (!isLatest && !rpsLocked) { %>
                            <span class="text-gray-400">|</span>
                            <!-- tombol pulihkan cuma muncul di revisi lama, bukan versi terbaru, & bukan pas RPS terkunci -->
                            <form class="inline-revert-form" action="/history/rps/<%= rps.id %>/revision/<%= rev.id %>/revert" method="POST" onsubmit="return confirm('Pulihkan RPS ke <%= rev.revision_name %>? Perubahan saat ini akan disimpan sebagai revisi baru.');">
                                <button type="submit" class="inline-revert-button">Pulihkan versi ini</button>
                            </form>
                        <% } else if (isLatest) { %>
                            <span class="text-gray-400">|</span>
                            <span class="text-gray-500">Versi saat ini</span>
                        <% } %>
                        <span class="text-gray-500">)</span>

                        <span class="revision-name"><%= rev.revision_name %></span>

                        <%
                            // change_stats (added/removed/modified) cuma ada di revisi baru
                            // (dibuat setelah fitur ini ada). Kalau ada, pakai itu supaya
                            // tanda +/- benar-benar mencerminkan isi yang ditambah/dihapus,
                            // bukan cuma jenis aksinya. Revisi lama tanpa change_stats tetap
                            // pakai cara lama (fallback) sebagai jaring pengaman.
                            const stats = rev.change_stats;
                            const hasStats = stats && (stats.added || stats.removed || stats.modified);
                        %>
                        <% if (hasStats) { %>
                            <% if (stats.added) { %><span class="revision-delta-positive">+<%= stats.added %></span><% } %>
                            <% if (stats.removed) { %><span class="revision-delta-revert">-<%= stats.removed %></span><% } %>
                            <% if (stats.modified) { %><span class="revision-delta-neutral">~<%= stats.modified %></span><% } %>
                        <% } else if (rev.action === 'revert') { %>
                            <span class="revision-delta-revert">(-<%= rev.changedCount || 0 %>)</span>
                        <% } else if ((rev.changedCount || 0) > 0) { %>
                            <span class="revision-delta-positive">(+<%= rev.changedCount %>)</span>
                        <% } else { %>
                            <span class="revision-delta-neutral">(0)</span>
                        <% } %>

                        <span class="action-badge <%= actionClass %>"><%= actionLabel %></span>
                        <span class="revision-link"><%= rev.editorName || rev.edited_by_username || 'System' %></span>

                        <% if (isLatest) { %>
                            <span class="current-badge"><i class="fas fa-check"></i> versi saat ini</span>
                        <% } %>

                        <% if (rev.message) { %>
                            <span class="text-gray-600">(<%= rev.message %>)</span>
                        <% } %>

                        <% if (rev.changed_fields && rev.changed_fields.length) { %>
                            <details class="mt-2 ml-2 text-sm text-gray-600">
                                <summary class="cursor-pointer text-gray-500">Lihat bagian yang berubah</summary>
                                <div class="mt-1 flex flex-wrap gap-1">
                                    <% rev.changed_fields.slice(0, 30).forEach(function(fieldName) { %>
                                        <span class="px-2 py-1 bg-gray-100 rounded text-xs"><%= fieldName %></span>
                                    <% }); %>
                                    <% if (rev.changed_fields.length > 30) { %>
                                        <span class="px-2 py-1 bg-gray-100 rounded text-xs">+<%= rev.changed_fields.length - 30 %> lainnya</span>
                                    <% } %>
                                </div>
                            </details>
                        <% } %>
                    </li>
                <% }); %>
            </ul>
        <% } else { %>
            <div class="text-center py-12">
                <i class="fas fa-clock-rotate-left text-5xl text-gray-300 mb-4"></i>
                <h3 class="text-lg font-semibold text-gray-800 mb-2">Belum ada riwayat revisi</h3>
                <p class="text-gray-600">Riwayat akan muncul setelah RPS dibuat atau diedit.</p>
            </div>
        <% } %>
    </div>
</div>

<%- include('partials/footer') %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    if (window.location.search.includes('reverted=1')) {
        Swal.fire({
            icon: 'success',
            title: 'RPS berhasil dipulihkan',
            text: 'Versi yang dipilih sekarang menjadi versi saat ini.',
            timer: 1800,
            showConfirmButton: false
        });
    }
</script>
