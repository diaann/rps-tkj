<%- include('partials/header') %>

<div class="container-custom admin-users-page">
    <!-- Admin Navigation -->
    <div class="card mb-6">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-center">
            <div>
                <h1 class="text-2xl font-bold text-gray-800 mb-2">Panel Admin</h1>
                <p class="text-gray-600">Kelola sistem RPS dan validasi user</p>
            </div>
            <div class="mt-4 md:mt-0 flex gap-2">
                <a href="/admin/rps" class="btn-primary flex items-center gap-2 px-4 py-2 text-sm">
                    <i class="fas fa-file-alt"></i>
                    Kelola RPS
                </a>
                <a href="/" class="btn-secondary flex items-center gap-2 px-4 py-2 text-sm">
                    <i class="fas fa-home"></i>
                    Dashboard
                </a>
            </div>
        </div>
    </div>

    <div class="card">
        <h2 class="card-title mb-6">Validasi User Baru</h2>

        <% if (typeof req !== 'undefined' && req.query && req.query.deleted) { %>
            <div class="p-3 bg-green-100 text-green-800 rounded mb-4">User berhasil dihapus.</div>
        <% } %>
        <% if (typeof req !== 'undefined' && req.query && req.query.error === 'self-delete') { %>
            <div class="p-3 bg-red-100 text-red-800 rounded mb-4">Tidak dapat menghapus akun sendiri yang sedang login.</div>
        <% } %>
        <% if (typeof req !== 'undefined' && req.query && req.query.error === 'not-found') { %>
            <div class="p-3 bg-red-100 text-red-800 rounded mb-4">User tidak ditemukan.</div>
        <% } %>

        <% const currentUserId = user.id; %>

        <!-- Versi compact (tombol + expand-row) -- HP saja, <768px -->
        <div class="overflow-x-auto md:hidden">
        <table class="min-w-full bg-white rounded-lg">
            <thead>
                <tr>
                    <th class="px-2 py-2 w-10"></th>
                    <th class="px-4 py-2 text-left">Email</th>
                    <th class="px-4 py-2 text-left">Username</th>
                </tr>
            </thead>
            <tbody>
                <% if (users.length === 0) { %>
                    <tr><td colspan="3" class="text-center py-4 text-gray-500">Tidak ada user pending validasi.</td></tr>
                <% } %>
                <% users.forEach(function(user) { %>
                    <tr class="border-t">
                        <td class="px-2 py-2 text-center">
                            <button type="button" class="row-expand-btn" id="user-expand-btn-<%= user.id %>"
                                    onclick="toggleUserRow('<%= user.id %>')"
                                    aria-expanded="false" aria-controls="user-detail-<%= user.id %>">
                                <i class="fas fa-plus" id="user-expand-icon-<%= user.id %>"></i>
                            </button>
                        </td>
                        <td class="px-4 py-2"><%= user.email %></td>
                        <td class="px-4 py-2"><%= user.username %></td>
                    </tr>
                    <tr id="user-detail-<%= user.id %>" class="hidden bg-gray-50 border-t">
                        <td colspan="3" class="px-4 py-3">
                            <dl class="row-detail-panel text-sm space-y-1 mb-3">
                                <div><dt>Nama:</dt> <dd><%= user.nama_lengkap || '-' %></dd></div>
                                <div><dt>Status:</dt> <dd><span class="inline-block px-2 py-1 rounded-full <%= user.status === 'active' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>"><%= user.status %></span></dd></div>
                            </dl>
                            <div class="mb-3">
                                <span class="font-semibold text-gray-600 text-sm block mb-1">Role:</span>
                                <form action="/admin/change-role/<%= user.id %>" method="POST" class="flex items-center gap-2 text-xs role-change-form" data-user-id="<%= user.id %>">
                                    <select name="role" class="border rounded px-2 py-1 focus:outline-none focus:ring role-select">
                                        <option value="dosen" <%= user.role === 'dosen' ? 'selected' : '' %>>dosen</option>
                                        <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>admin</option>
                                    </select>
                                    <input type="hidden" name="ajax" value="1">
                                    <button type="submit" class="btn-secondary px-2 py-1">Ubah</button>
                                </form>
                            </div>
                            <div class="flex items-center gap-2 flex-wrap">
                                <% if (user.status === 'pending') { %>
                                    <form action="/admin/validate/<%= user.id %>" method="POST" class="inline">
                                        <button class="btn-primary text-xs" type="submit">Validasi</button>
                                    </form>
                                <% } else { %>
                                    <span class="text-green-600 font-semibold text-xs">Tervalidasi</span>
                                <% } %>
                                <% if (user.id !== currentUserId) { %>
                                    <form action="/admin/users/delete/<%= user.id %>" method="POST" class="inline" onsubmit="return confirm('Hapus user ini?')">
                                        <button class="btn-danger text-xs" type="submit">Delete</button>
                                    </form>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
        </div>

        <!-- Versi klasik (semua kolom sekaligus) -- tablet & desktop, >=768px -->
        <div class="overflow-x-auto hidden md:block">
        <table class="min-w-full bg-white rounded-lg">
            <thead>
                <tr>
                    <th class="px-4 py-2 text-left">Email</th>
                    <th class="px-4 py-2 text-left">Username</th>
                    <th class="px-4 py-2 text-left">Nama</th>
                    <th class="px-4 py-2 text-left">Role</th>
                    <th class="px-4 py-2 text-left">Status</th>
                    <th class="px-4 py-2 text-left">Aksi</th>
                </tr>
            </thead>
            <tbody>
                <% if (users.length === 0) { %>
                    <tr><td colspan="6" class="text-center py-4 text-gray-500">Tidak ada user pending validasi.</td></tr>
                <% } %>
                <% users.forEach(function(user) { %>
                    <tr class="border-t">
                        <td class="px-4 py-2"><%= user.email %></td>
                        <td class="px-4 py-2"><%= user.username %></td>
                        <td class="px-4 py-2"><%= user.nama_lengkap || '-' %></td>
                        <td class="px-4 py-2 capitalize">
                            <form action="/admin/change-role/<%= user.id %>" method="POST" class="flex items-center gap-2 text-xs role-change-form" data-user-id="<%= user.id %>">
                                <select name="role" class="border rounded px-2 py-1 focus:outline-none focus:ring role-select">
                                    <option value="dosen" <%= user.role === 'dosen' ? 'selected' : '' %>>dosen</option>
                                    <option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>admin</option>
                                </select>
                                <input type="hidden" name="ajax" value="1">
                                <button type="submit" class="btn-secondary px-2 py-1">Ubah</button>
                            </form>
                        </td>
                        <td class="px-4 py-2"><span class="inline-block px-2 py-1 rounded-full <%= user.status === 'active' ? 'bg-green-100 text-green-700' : 'bg-yellow-100 text-yellow-700' %>"><%= user.status %></span></td>
                        <td class="px-4 py-2">
                            <div class="flex items-center gap-2">
                                <% if (user.status === 'pending') { %>
                                    <form action="/admin/validate/<%= user.id %>" method="POST" class="inline">
                                        <button class="btn-primary text-xs" type="submit">Validasi</button>
                                    </form>
                                <% } else { %>
                                    <span class="text-green-600 font-semibold text-xs">Tervalidasi</span>
                                <% } %>
                                <% if (user.id !== currentUserId) { %>
                                    <form action="/admin/users/delete/<%= user.id %>" method="POST" class="inline" onsubmit="return confirm('Hapus user ini?')">
                                        <button class="btn-danger text-xs" type="submit">Delete</button>
                                    </form>
                                <% } %>
                            </div>
                        </td>
                    </tr>
                <% }); %>
            </tbody>
        </table>
        </div>
    </div>
</div>

<%- include('partials/footer') %>

<script>
// AJAX submit untuk perubahan role
document.querySelectorAll('.role-change-form').forEach(form => {
        form.addEventListener('submit', async (e) => {
        e.preventDefault();
        const userId = form.getAttribute('data-user-id');
        const select = form.querySelector('.role-select');
        const newRole = select.value;
        // Use URLSearchParams so bodyParser.urlencoded can parse the request
        const params = new URLSearchParams();
        params.append('role', newRole);
        const ajaxInput = form.querySelector('input[name="ajax"]');
        if (ajaxInput) params.append('ajax', ajaxInput.value);
        try {
            const res = await fetch(form.action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: params.toString()
            });
            const contentType = res.headers.get('content-type') || '';
            if (contentType.includes('application/json')) {
                const data = await res.json();
                if (data.success) {
                    const name = data.username || `#${userId}`;
                    showToast(`Role user ${name} berubah: ${data.oldRole} → ${data.newRole}`, 'success');
                } else {
                    showToast(data.message || 'Gagal mengubah role', 'error');
                }
            } else {
                // Fallback jika server redirect (tidak pakai AJAX path)
                location.reload();
            }
        } catch (err) {
            showToast('Error jaringan: ' + err.message, 'error');
        }
    });
});

// buka/tutup panel detail (Nama/Status/Role/Aksi) per baris user di tabel,
// dipicu tombol bulat (+) supaya di HP/tablet tidak perlu geser horizontal
function toggleUserRow(id) {
    const row = document.getElementById('user-detail-' + id);
    const btn = document.getElementById('user-expand-btn-' + id);
    const icon = document.getElementById('user-expand-icon-' + id);
    if (!row || !btn || !icon) return;
    const isHidden = row.classList.contains('hidden');
    row.classList.toggle('hidden', !isHidden);
    btn.classList.toggle('expanded', isHidden);
    btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
    icon.classList.toggle('fa-plus', !isHidden);
    icon.classList.toggle('fa-minus', isHidden);
}

function showToast(msg, type='info') {
    const existing = document.getElementById('toast-role');
    if (existing) existing.remove();
    const div = document.createElement('div');
    div.id = 'toast-role';
    const color = type==='success' ? 'bg-green-600' : type==='error' ? 'bg-red-600' : 'bg-gray-700';
    div.className = `${color} fixed top-4 right-4 text-white px-4 py-2 rounded shadow z-50 text-sm`; 
    div.textContent = msg;
    document.body.appendChild(div);
    setTimeout(() => div.remove(), 4000);
}
</script>
