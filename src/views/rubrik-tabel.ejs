<%- include('partials/header') %>

<%
// kode di dalam blok ini jalan di SERVER (bukan di browser), pas halaman lagi dirakit.
// helper kecil: bikin "kode unik" per rubrik (misal "r3" utk rubrik id 3, atau "new" utk
// form tambah rubrik baru) -- dipakai sbg penanda di HTML (atribut data-form="...") biar
// javascript nanti bisa tau form/tombol mana yg lagi diutak-atik kalau ada BANYAK rubrik
// sekaligus di 1 halaman.
function formIdFor(rubrik) { return rubrik ? ('r' + rubrik.id) : 'new'; }
%>

    <div class="container-custom">
        <div class="card mb-6">
            <h1 class="text-2xl font-bold text-gray-800 mb-2">Rubrik Penilaian</h1>
            <p class="text-gray-600">
                <span class="font-semibold"><%= rpsItem.nama_mk %></span>
                &middot; Semester <%= rpsItem.semester %>
                <% if (rpsItem.kode_mk) { %>&middot; <%= rpsItem.kode_mk %><% } %>
            </p>
        </div>

        <% if (saved) { %>
            <div class="mb-4 p-3 rounded bg-green-100 text-green-800 border border-green-300">
                <i class="fas fa-check-circle mr-1"></i> Rubrik berhasil disimpan.
            </div>
        <% } %>
        <% if (deleted) { %>
            <div class="mb-4 p-3 rounded bg-green-100 text-green-800 border border-green-300">
                <i class="fas fa-check-circle mr-1"></i> Rubrik berhasil dihapus.
            </div>
        <% } %>
        <% if (typeof req !== 'undefined' && req.query && req.query.error) { %>
            <div class="mb-4 p-3 rounded bg-red-100 text-red-800 border border-red-300">
                <i class="fas fa-exclamation-circle mr-1"></i> Nama rubrik, skala skor, dan minimal 1 kriteria wajib diisi.
            </div>
        <% } %>

        <% if (rubrikList.length === 0) { %>
            <div class="card text-center py-8 text-gray-500 mb-6">
                <i class="fas fa-clipboard-list text-3xl mb-2 block"></i>
                Belum ada data rubrik untuk mata kuliah ini.
            </div>
        <% } %>

        <div class="card">
            <!-- Tab navigation: satu tab per rubrik + satu tab "Tambah Rubrik" -->
            <div class="flex flex-wrap gap-2 -mb-px">
                <% rubrikList.forEach(function (rb, idx) { %>
                    <button type="button"
                        class="rubrik-tab-btn px-4 py-2 text-sm font-medium rounded-t-lg border border-b-0 <%= idx === 0 ? 'bg-white border-blue-500 text-blue-700' : 'bg-gray-50 border-transparent text-gray-500 hover:text-blue-600' %>"
                        onclick="showRubrikTab('rubrik-panel-<%= rb.id %>', this)">
                        <%= rb.nama %>
                    </button>
                <% }); %>
                <button type="button"
                    class="rubrik-tab-btn px-4 py-2 text-sm font-medium rounded-t-lg border border-b-0 <%= rubrikList.length === 0 ? 'bg-white border-blue-500 text-blue-700' : 'bg-gray-50 border-transparent text-gray-500 hover:text-blue-600' %>"
                    onclick="showRubrikTab('rubrik-panel-new', this)">
                    <i class="fas fa-plus mr-1"></i>Tambah Rubrik
                </button>
            </div>

            <!-- Panel per rubrik yang sudah ada -->
            <% rubrikList.forEach(function (rb, idx) { %>
                <% const fid = formIdFor(rb); %>
                <div id="rubrik-panel-<%= rb.id %>" class="rubrik-tab-panel <%= idx === 0 ? '' : 'hidden' %> pt-4">

                    <!-- Mode lihat (default) -->
                    <div data-view="<%= fid %>">
                        <div class="flex justify-end gap-2 mb-3">
                            <button type="button" class="btn-secondary px-4 py-2 rounded" onclick="toggleRubrikEdit('<%= fid %>')">
                                <i class="fas fa-pen mr-1"></i>Edit
                            </button>
                            <form method="POST" action="/rubrik/mk/<%= rpsItem.id %>/<%= rb.id %>/delete" onsubmit="return confirm('Hapus rubrik ini?')">
                                <button type="submit" class="btn-danger px-4 py-2 rounded">
                                    <i class="fas fa-trash mr-1"></i>Hapus
                                </button>
                            </form>
                        </div>

                        <div class="overflow-x-auto">
                            <table class="table-auto w-full border-collapse text-sm">
                                <thead class="bg-blue-50">
                                    <tr>
                                        <th class="px-3 py-2 border text-left font-semibold whitespace-nowrap">Aspek Penilaian</th>
                                        <% rb.skala.forEach(function (s) { %>
                                            <th class="px-3 py-2 border text-center font-semibold whitespace-nowrap">
                                                Skor <%= s.skor %><% if (s.label) { %> (<%= s.label %>)<% } %>
                                            </th>
                                        <% }); %>
                                    </tr>
                                </thead>
                                <tbody class="divide-y divide-gray-200">
                                    <% rb.kriteria.forEach(function (kr) { %>
                                        <tr class="hover:bg-gray-50 align-top">
                                            <td class="px-3 py-2 border font-medium" style="min-width:9rem;"><%= kr.aspek %></td>
                                            <% kr.deskripsi.forEach(function (d) { %>
                                                <td class="px-3 py-2 border" style="white-space:pre-line;min-width:12rem;"><%= d %></td>
                                            <% }); %>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                        </div>
                    </div>

                    <!-- Mode edit (tersembunyi sampai tombol Edit ditekan) -->
                    <div data-edit="<%= fid %>" class="hidden">
                        <!-- onsubmit="return reindexRubrikForm(...)" -- ini trik penting: SEBELUM
                             form ini beneran terkirim ke server, javascript reindexRubrikForm()
                             dijalanin dulu (lihat definisinya di <script> paling bawah). kalau
                             fungsi itu mengembalikan false, PENGIRIMAN FORM DIBATALKAN (berguna
                             buat validasi: kalau ada yg belum diisi, munculin alert & batalin submit) -->
                        <form method="POST" action="/rubrik/mk/<%= rpsItem.id %>/<%= rb.id %>/edit" onsubmit="return reindexRubrikForm('<%= fid %>')">
                            <%- include('partials/rubrik-form-fields', { fid: fid, rubrik: rb }) %>
                            <div class="mt-4 flex justify-end gap-2">
                                <button type="button" class="btn-secondary px-4 py-2 rounded" onclick="toggleRubrikEdit('<%= fid %>')">Batal</button>
                                <button type="submit" class="btn-primary px-6 py-2 rounded"><i class="fas fa-save mr-1"></i>Simpan Perubahan</button>
                            </div>
                        </form>
                    </div>
                </div>
            <% }); %>

            <!-- Panel tambah rubrik baru -->
            <div id="rubrik-panel-new" class="rubrik-tab-panel <%= rubrikList.length === 0 ? '' : 'hidden' %> pt-4">
                <form method="POST" action="/rubrik/mk/<%= rpsItem.id %>/add" onsubmit="return reindexRubrikForm('new')">
                    <%- include('partials/rubrik-form-fields', { fid: 'new', rubrik: null }) %>
                    <div class="mt-4 flex justify-end">
                        <button type="submit" class="btn-primary px-6 py-2 rounded"><i class="fas fa-plus mr-1"></i>Tambah Rubrik</button>
                    </div>
                </form>
            </div>
        </div>

        <a href="/rubrik" class="btn-secondary mt-4 px-4 py-2 rounded bg-gray-500 text-white hover:bg-gray-600 inline-block">Kembali</a>
    </div>

    <script>
        // semua kode di dalam <script> ini jalan di BROWSER (bukan server), sesudah
        // halaman HTML-nya kekirim & tampil ke user.

        // --- Tab switching (persis pola di Tabel Penilaian) ---
        // dipanggil tiap kali tombol tab (nama rubrik / "Tambah Rubrik") diklik.
        // caranya: SEMBUNYIIN semua panel & non-aktifin semua tombol tab dulu,
        // BARU tampilin panel yg dipilih & tandain tombolnya sbg "aktif" (warna biru).
        function showRubrikTab(targetId, btnEl) {
            document.querySelectorAll('.rubrik-tab-panel').forEach(function (panel) {
                panel.classList.add('hidden'); // class "hidden" = css buat display:none
            });
            document.querySelectorAll('.rubrik-tab-btn').forEach(function (btn) {
                btn.classList.remove('bg-white', 'border-blue-500', 'text-blue-700');
                btn.classList.add('bg-gray-50', 'border-transparent', 'text-gray-500');
            });
            const target = document.getElementById(targetId);
            if (target) target.classList.remove('hidden'); // tampilin panel yg dipilih
            if (btnEl) {
                // kasih warna "aktif" ke tombol yg baru diklik
                btnEl.classList.remove('bg-gray-50', 'border-transparent', 'text-gray-500');
                btnEl.classList.add('bg-white', 'border-blue-500', 'text-blue-700');
            }
        }

        // --- Toggle lihat/edit untuk satu rubrik ---
        // tiap rubrik punya 2 tampilan yg saling GANTIAN (bukan bareng2): mode "lihat"
        // (tabel biasa, cuma buat diliat) dan mode "edit" (form yg bisa diubah).
        // fungsi ini yg nuker antara 2 mode itu pas tombol "Edit"/"Batal" diklik.
        function toggleRubrikEdit(fid) {
            const viewEl = document.querySelector('[data-view="' + fid + '"]');
            const editEl = document.querySelector('[data-edit="' + fid + '"]');
            if (!viewEl || !editEl) return;
            const showEdit = editEl.classList.contains('hidden'); // lagi disembunyiin -> berarti mau ditampilin
            viewEl.classList.toggle('hidden', showEdit);  // kalau mode edit mau ditampilin, mode lihat disembunyiin
            editEl.classList.toggle('hidden', !showEdit); // dan sebaliknya
        }

        // --- Kolom skala (Skor N + Label): tambah selalu di akhir, hapus cuma yang paling akhir.
        // Setiap kolom ditambah/dihapus juga menambah/menghapus 1 sel deskripsi yang sepadan
        // di SETIAP baris kriteria, supaya jumlah kolom deskripsi selalu sinkron dgn skala. ---
        function addSkalaColumn(fid) {
            const container = document.querySelector('[data-form="' + fid + '"] [data-skala-container]');
            if (!container) return;
            const cols = container.querySelectorAll('.rubrik-skala-col');
            const newCol = document.createElement('div');
            newCol.className = 'rubrik-skala-col';
            newCol.innerHTML =
                '<label class="label text-xs">Skor</label>' +
                '<input type="text" class="input rubrik-skor-input" placeholder="4">' +
                '<label class="label text-xs">Label</label>' +
                '<input type="text" class="input rubrik-label-input" placeholder="Sangat Baik">';
            container.appendChild(newCol);
            updateSkalaButtons(fid);

            // Tambahkan 1 textarea deskripsi baru di setiap baris kriteria yang sudah ada.
            const rows = document.querySelectorAll('[data-form="' + fid + '"] .rubrik-kriteria-row');
            rows.forEach(function (row) {
                appendDeskripsiCell(row);
            });
        }

        function removeLastSkalaColumn(fid) {
            const container = document.querySelector('[data-form="' + fid + '"] [data-skala-container]');
            if (!container) return;
            const cols = container.querySelectorAll('.rubrik-skala-col');
            if (cols.length <= 1) return; // minimal 1 kolom skala
            cols[cols.length - 1].remove();
            updateSkalaButtons(fid);

            const rows = document.querySelectorAll('[data-form="' + fid + '"] .rubrik-kriteria-row');
            rows.forEach(function (row) {
                const cells = row.querySelectorAll('.rubrik-deskripsi-cell');
                if (cells.length > 0) cells[cells.length - 1].remove();
            });
        }

        // matikan tombol "- Kolom" kalau kolom skala tinggal 1 (minimal harus ada 1)
        function updateSkalaButtons(fid) {
            const container = document.querySelector('[data-form="' + fid + '"] [data-skala-container]');
            if (!container) return;
            const cols = container.querySelectorAll('.rubrik-skala-col');
            const removeBtn = document.querySelector('[data-form="' + fid + '"] [data-remove-skala-btn]');
            if (removeBtn) {
                removeBtn.disabled = cols.length <= 1;
                removeBtn.classList.toggle('opacity-50', cols.length <= 1);
                removeBtn.classList.toggle('cursor-not-allowed', cols.length <= 1);
            }
        }

        // tambah 1 kotak deskripsi baru ("Level ke-N") ke sebuah baris kriteria
        function appendDeskripsiCell(row, value) {
            const cellsContainer = row.querySelector('.rubrik-deskripsi-cells');
            if (!cellsContainer) return;
            const position = cellsContainer.querySelectorAll('.rubrik-deskripsi-cell').length + 1;
            const cell = document.createElement('div');
            cell.className = 'rubrik-deskripsi-cell';
            const labelEl = document.createElement('span');
            labelEl.className = 'rubrik-deskripsi-cell-label';
            labelEl.textContent = 'Level ke-' + position;
            const ta = document.createElement('textarea');
            ta.className = 'input rubrik-deskripsi-input';
            ta.rows = 3;
            ta.placeholder = 'Deskripsi kriteria pada level skor ini';
            if (value) ta.value = value;
            cell.appendChild(labelEl);
            cell.appendChild(ta);
            cellsContainer.appendChild(cell);
        }

        // --- Baris kriteria: tambah/hapus bebas di posisi manapun (tidak saling bergantung
        // antar baris), jumlah kolom deskripsi baris baru mengikuti jumlah kolom skala saat ini. ---
        function addKriteriaRow(fid) {
            const container = document.querySelector('[data-form="' + fid + '"] [data-kriteria-container]');
            if (!container) return;
            const colCount = document.querySelectorAll('[data-form="' + fid + '"] .rubrik-skala-col').length;

            const row = document.createElement('div');
            row.className = 'rubrik-kriteria-row';
            row.innerHTML =
                '<div class="rubrik-kriteria-head">' +
                '  <label class="label text-xs">Aspek / Kriteria</label>' +
                '  <input type="text" class="input rubrik-aspek-input" placeholder="mis. Kelengkapan Jawaban" required>' +
                '  <button type="button" class="btn-danger px-3 py-1 rounded text-sm" onclick="removeKriteriaRow(this)"><i class="fas fa-trash"></i></button>' +
                '</div>' +
                '<div class="rubrik-deskripsi-cells"></div>';
            container.appendChild(row);

            for (let i = 0; i < colCount; i++) appendDeskripsiCell(row);
            if (window.initRealtimeValidation) window.initRealtimeValidation(row);
        }

        function removeKriteriaRow(button) {
            const row = button.closest('.rubrik-kriteria-row');
            const container = row.closest('[data-kriteria-container]');
            if (!row || !container) return;
            const rows = container.querySelectorAll('.rubrik-kriteria-row');
            if (rows.length <= 1) return; // minimal 1 kriteria
            row.remove();
        }

        // --- Sebelum submit: rapikan ulang nama field jadi skala[j][skor], skala[j][label],
        // kriteria[i][aspek], kriteria[i][deskripsi][k] berdasarkan urutan tampil di DOM,
        // supaya server tidak perlu mikirin index yang bolong akibat tambah/hapus baris/kolom. ---
        function reindexRubrikForm(fid) {
            const scope = document.querySelector('[data-form="' + fid + '"]');
            if (!scope) return true;

            const cols = scope.querySelectorAll('.rubrik-skala-col');
            if (cols.length === 0) {
                alert('Tambahkan minimal 1 kolom skala skor.');
                return false;
            }
            cols.forEach(function (col, j) {
                const skorInput = col.querySelector('.rubrik-skor-input');
                const labelInput = col.querySelector('.rubrik-label-input');
                if (skorInput) skorInput.setAttribute('name', 'skala[' + j + '][skor]');
                if (labelInput) labelInput.setAttribute('name', 'skala[' + j + '][label]');
            });

            const rows = scope.querySelectorAll('.rubrik-kriteria-row');
            if (rows.length === 0) {
                alert('Tambahkan minimal 1 kriteria.');
                return false;
            }
            let ok = true;
            rows.forEach(function (row, i) {
                const aspekInput = row.querySelector('.rubrik-aspek-input');
                if (aspekInput) {
                    aspekInput.setAttribute('name', 'kriteria[' + i + '][aspek]');
                    if (!aspekInput.value.trim()) ok = false;
                }
                const deskripsiInputs = row.querySelectorAll('.rubrik-deskripsi-input');
                deskripsiInputs.forEach(function (ta, k) {
                    ta.setAttribute('name', 'kriteria[' + i + '][deskripsi][' + k + ']');
                });
            });

            const namaInput = scope.querySelector('.rubrik-nama-input');
            if (namaInput && !namaInput.value.trim()) ok = false;

            if (!ok) {
                alert('Lengkapi dulu nama rubrik dan nama setiap aspek/kriteria.');
                return false;
            }
            return true;
        }
    </script>

<%- include('partials/footer') %>
