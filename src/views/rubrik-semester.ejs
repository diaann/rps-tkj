<%- include('partials/header') %>

    <div class="container-custom">
        <div class="card mb-6">
            <h1 class="text-2xl font-bold text-gray-800 mb-2">Rubrik Penilaian</h1>
            <p class="text-gray-600">Pilih semester dan mata kuliah untuk melihat atau mengelola rubrik penilaiannya.</p>
        </div>

        <div class="card">
            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2">Semester</label>
                <select id="pilih-semester" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700">
                    <option value="">-- Pilih Semester --</option>
                    <% for (let s = 1; s <= 8; s++) { %>
                        <option value="<%= s %>">Semester <%= s %></option>
                    <% } %>
                </select>
            </div>

            <div class="mb-4">
                <label class="block text-gray-700 text-sm font-bold mb-2">Mata Kuliah</label>
                <select id="pilih-matkul" class="shadow appearance-none border rounded w-full py-2 px-3 text-gray-700" disabled>
                    <option value="">-- Pilih Semester dahulu --</option>
                </select>
            </div>

            <div id="rubrik-empty-msg" class="hidden mb-4 p-3 rounded bg-yellow-50 text-yellow-800 border border-yellow-200 text-sm"></div>

            <button id="btn-lihat-rubrik" type="button" disabled
                class="btn-primary px-6 py-2 rounded opacity-50 cursor-not-allowed">
                <i class="fas fa-clipboard-list mr-1"></i>Lihat Rubrik Penilaian
            </button>
        </div>

        <a href="/" class="btn-secondary mt-4 px-4 py-2 rounded bg-gray-500 text-white hover:bg-gray-600 inline-block">Kembali</a>
    </div>

    <script>
        // semua data matkul dikirim sekali di awal, difilter di browser -> ga perlu reload halaman
        const MATKUL_DATA = <%- JSON.stringify(matkulData) %>;

        const semesterEl = document.getElementById('pilih-semester');
        const matkulEl = document.getElementById('pilih-matkul');
        const btnEl = document.getElementById('btn-lihat-rubrik');
        const emptyMsgEl = document.getElementById('rubrik-empty-msg');

        // kosongkan & kunci/buka sebuah dropdown
        function resetSelect(selectEl, placeholder, disabled) {
            selectEl.innerHTML = '<option value="">' + placeholder + '</option>';
            selectEl.disabled = disabled;
        }

        // tombol "Lihat Rubrik" cuma aktif kalau semester & matkul udah dipilih
        function updateButtonState() {
            const ready = semesterEl.value && matkulEl.value;
            btnEl.disabled = !ready;
            btnEl.classList.toggle('opacity-50', !ready);
            btnEl.classList.toggle('cursor-not-allowed', !ready);
        }

        // pilih semester -> isi ulang dropdown Mata Kuliah sesuai semester itu
        semesterEl.addEventListener('change', function () {
            resetSelect(matkulEl, '-- Pilih Mata Kuliah --', true);
            emptyMsgEl.classList.add('hidden');
            updateButtonState();

            const semester = this.value;
            if (!semester) return;

            const filtered = MATKUL_DATA.filter(function (mk) { return String(mk.semester) === String(semester); });
            if (filtered.length === 0) {
                emptyMsgEl.textContent = 'Tidak ada mata kuliah pada semester ini.';
                emptyMsgEl.classList.remove('hidden');
                resetSelect(matkulEl, '-- Tidak ada mata kuliah --', true);
                return;
            }

            matkulEl.disabled = false;
            matkulEl.innerHTML = '<option value="">-- Pilih Mata Kuliah --</option>';
            filtered.forEach(function (mk) {
                const opt = document.createElement('option');
                opt.value = mk.id;
                opt.textContent = mk.nama_mk + (mk.kode_mk ? ' (' + mk.kode_mk + ')' : '');
                matkulEl.appendChild(opt);
            });
        });

        matkulEl.addEventListener('change', updateButtonState);

        // pindah ke halaman rubrik mata kuliah yg dipilih
        btnEl.addEventListener('click', function () {
            if (btnEl.disabled) return;
            window.location.href = '/rubrik/mk/' + encodeURIComponent(matkulEl.value);
        });
    </script>

<%- include('partials/footer') %>
